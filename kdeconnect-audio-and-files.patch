--- /dev/null
+++ b/src/main/java/org/kde/kdeconnect/plugins/screenshare/ScreenSharePlugin.kt
@@ -0,0 +1,378 @@
+/*
+ * SPDX-FileCopyrightText: 2026 KDE Connect contributors
+ *
+ * SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+package org.kde.kdeconnect.plugins.screenshare
+
+import android.Manifest
+import android.app.Activity
+import android.app.NotificationManager
+import android.app.PendingIntent
+import android.content.Intent
+import android.content.pm.PackageManager
+import android.os.Build
+import android.os.Handler
+import android.os.Looper
+import android.util.Log
+import android.widget.Toast
+import androidx.annotation.StringRes
+import androidx.core.app.NotificationCompat
+import androidx.core.content.ContextCompat
+import androidx.core.content.getSystemService
+import org.kde.kdeconnect.NetworkPacket
+import org.kde.kdeconnect.helpers.NotificationHelper
+import org.kde.kdeconnect.plugins.Plugin
+import org.kde.kdeconnect.plugins.PluginFactory.LoadablePlugin
+import org.kde.kdeconnect_tp.R
+
+/**
+ * Shows the screen of one phone on another, live, as H.264 video.
+ *
+ * - "View its screen": this phone asks the other one to start sharing, and shows the picture.
+ * - "Share my screen here": this phone starts sharing its own screen with the other one.
+ *
+ * The video travels through the payload of a `kdeconnect.screenshare` packet, over the same
+ * encrypted connection used by the rest of KDE Connect (Wi-Fi, or Bluetooth when there is no Wi-Fi).
+ */
+@LoadablePlugin
+class ScreenSharePlugin : Plugin() {
+
+    override val displayName: String
+        get() = context.getString(R.string.pref_plugin_screenshare)
+
+    override val description: String
+        get() = context.getString(R.string.pref_plugin_screenshare_desc)
+
+    override val supportedPacketTypes: Array<String> =
+        arrayOf(PACKET_TYPE_SCREENSHARE, PACKET_TYPE_SCREENSHARE_REQUEST, PACKET_TYPE_SCREENSHARE_CONTROL)
+
+    override val outgoingPacketTypes: Array<String> =
+        arrayOf(PACKET_TYPE_SCREENSHARE, PACKET_TYPE_SCREENSHARE_REQUEST, PACKET_TYPE_SCREENSHARE_CONTROL)
+
+    private var lastUnavailableNoticeAt = 0L
+
+    override fun onDestroy() {
+        ScreenShareState.stopIfSharingWith(device.deviceId)
+    }
+
+    override fun onPacketReceived(np: NetworkPacket): Boolean {
+        return when (np.type) {
+            PACKET_TYPE_SCREENSHARE -> handleIncomingStream(np)
+            PACKET_TYPE_SCREENSHARE_REQUEST -> handleRequest(np)
+            PACKET_TYPE_SCREENSHARE_CONTROL -> handleControl(np)
+            else -> false
+        }
+    }
+
+    // -- Viewing ------------------------------------------------------------------------------
+
+    private fun handleIncomingStream(np: NetworkPacket): Boolean {
+        val payload = np.payload
+        if (payload == null) {
+            Log.w(LOG_TAG, "Received a screen stream without data")
+            return false
+        }
+
+        val width = np.getInt("width", 0)
+        val height = np.getInt("height", 0)
+        val codec = np.getString("codec", "")
+        if (codec != CODEC_H264 || width !in 16..8192 || height !in 16..8192) {
+            Log.w(LOG_TAG, "Unsupported screen stream: $codec ${width}x$height")
+            payload.close()
+            return false
+        }
+
+        val header = StreamHeader(width, height, np.getInt("fps", 30), np.getInt("bitrate", 0))
+        val listener = ScreenShareState.viewerListener
+        if (listener != null) {
+            listener(header, payload)
+        } else {
+            // Nobody is looking at the viewer: keep the stream and ask the user to open it
+            ScreenShareState.setPending(header, payload)
+            showViewNotification()
+        }
+        return true
+    }
+
+    /** Called by the viewer screen. */
+    internal fun requestStart(preset: ScreenPreset, autoStopMinutes: Int, sound: Boolean) {
+        device.sendPacket(request(ACTION_START).apply {
+            this["preset"] = preset.name
+            this["autoStopMinutes"] = autoStopMinutes
+            this["sound"] = sound
+        })
+    }
+
+    fun requestStop() {
+        device.sendPacket(request(ACTION_STOP))
+    }
+
+    fun requestKeyframe() {
+        device.sendPacket(request(ACTION_KEYFRAME))
+    }
+
+    fun sendBitrate(bitrate: Int) {
+        device.sendPacket(request(ACTION_BITRATE).apply { this["bitrate"] = bitrate })
+    }
+
+    fun sendPing() {
+        device.sendPacket(request(ACTION_PING).apply { this["ts"] = System.currentTimeMillis() })
+    }
+
+    /**
+     * Sends a live touch of the viewer. [points] is "id,x,y;id,x,y" with x and y between 0 and 1.
+     * [startX] and [startY] say where the finger really started, if it has already moved.
+     */
+    fun sendTouch(action: String, changedId: Int, points: String, startX: Float?, startY: Float?) {
+        device.sendPacket(NetworkPacket(PACKET_TYPE_SCREENSHARE_CONTROL).apply {
+            this["kind"] = KIND_TOUCH
+            this["action"] = action
+            this["id"] = changedId
+            this["points"] = points
+            if (startX != null && startY != null) {
+                this["sx"] = startX.toDouble()
+                this["sy"] = startY.toDouble()
+            }
+        })
+    }
+
+    /** A complete quick tap at x, y (both between 0 and 1). */
+    fun sendTap(x: Float, y: Float) {
+        device.sendPacket(NetworkPacket(PACKET_TYPE_SCREENSHARE_CONTROL).apply {
+            this["kind"] = KIND_TAP
+            this["x"] = x.toDouble()
+            this["y"] = y.toDouble()
+        })
+    }
+
+    /** A complete swipe through [points] ("x,y;x,y"), which took [durationMs]. */
+    fun sendSwipe(points: String, durationMs: Int) {
+        device.sendPacket(NetworkPacket(PACKET_TYPE_SCREENSHARE_CONTROL).apply {
+            this["kind"] = KIND_SWIPE
+            this["points"] = points
+            this["duration"] = durationMs
+        })
+    }
+
+    /** Presses a system button on the other phone: back, home, recents, notifications or power. */
+    fun sendGlobalAction(name: String) {
+        device.sendPacket(NetworkPacket(PACKET_TYPE_SCREENSHARE_CONTROL).apply {
+            this["kind"] = KIND_GLOBAL
+            this["name"] = name
+        })
+    }
+
+    private fun request(action: String) = NetworkPacket(PACKET_TYPE_SCREENSHARE_REQUEST).apply {
+        this["action"] = action
+    }
+
+    private fun showViewNotification() {
+        if (!notificationsAllowed()) {
+            toast(R.string.screenshare_open_app_hint, device.name)
+            return
+        }
+        val viewIntent = Intent(context, ScreenViewerActivity::class.java)
+            .putExtra(ScreenViewerActivity.EXTRA_DEVICE_ID, device.deviceId)
+            .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
+        val pendingIntent = PendingIntent.getActivity(
+            context,
+            device.deviceId.hashCode() xor 0x56,
+            viewIntent,
+            PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE
+        )
+        val notification = NotificationCompat.Builder(context, NotificationHelper.Channels.HIGHPRIORITY)
+            .setSmallIcon(R.drawable.ic_notification)
+            .setContentTitle(context.getString(R.string.screenshare_view_title, device.name))
+            .setContentText(context.getString(R.string.screenshare_view_text))
+            .setContentIntent(pendingIntent)
+            .setAutoCancel(true)
+            .setPriority(NotificationCompat.PRIORITY_HIGH)
+            .build()
+        context.getSystemService<NotificationManager>()!!.notify(device.deviceId.hashCode() xor 0x56, notification)
+    }
+
+    // -- Sharing ------------------------------------------------------------------------------
+
+    private fun handleRequest(np: NetworkPacket): Boolean {
+        when (np.getString("action")) {
+            ACTION_START -> showShareRequest(
+                ScreenPreset.fromName(np.getString("preset", ScreenPreset.DEFAULT.name)),
+                np.getInt("autoStopMinutes", 0),
+                np.getBoolean("sound", true)
+            )
+            ACTION_STOP -> ScreenShareState.stopIfSharingWith(device.deviceId)
+            ACTION_KEYFRAME -> ScreenShareState.requestKeyframeIfSharingWith(device.deviceId)
+            ACTION_BITRATE -> ScreenShareState.setBitrateIfSharingWith(device.deviceId, np.getInt("bitrate", 0))
+            ACTION_PING -> device.sendPacket(request(ACTION_PONG).apply { this["ts"] = np.getLong("ts", 0L) })
+            ACTION_PONG -> ScreenShareState.lastRttMs = maxOf(0L, System.currentTimeMillis() - np.getLong("ts", 0L))
+            ACTION_GESTURE_RESULT -> ScreenShareState.lastGestureResult = np.getString("text", "-")
+            ACTION_CONTROL_UNAVAILABLE -> toast(R.string.screenshare_control_unavailable, device.name)
+            else -> return false
+        }
+        return true
+    }
+
+    /**
+     * Touches and button presses from the viewer. They are only accepted while this phone is
+     * sharing its screen with that device, which the user started and can stop at any time.
+     */
+    private fun handleControl(np: NetworkPacket): Boolean {
+        if (!ScreenShareState.isSharingWith(device.deviceId)) return false
+
+        if (!RemoteTouchInjector.isAvailable) {
+            val now = System.currentTimeMillis()
+            if (now - lastUnavailableNoticeAt > UNAVAILABLE_NOTICE_INTERVAL_MS) {
+                lastUnavailableNoticeAt = now
+                device.sendPacket(request(ACTION_CONTROL_UNAVAILABLE))
+                toast(R.string.screenshare_control_needs_accessibility)
+            }
+            return true
+        }
+
+        // Tell the viewer how each tap and swipe went (it is shown in the speed readout)
+        RemoteTouchInjector.onResult = { text ->
+            device.sendPacket(request(ACTION_GESTURE_RESULT).apply { this["text"] = text })
+        }
+
+        when (np.getString("kind")) {
+            KIND_TOUCH -> {
+                val start = if (np.has("sx") && np.has("sy")) {
+                    np.getDouble("sx").toFloat() to np.getDouble("sy").toFloat()
+                } else {
+                    null
+                }
+                RemoteTouchInjector.touch(
+                    np.getString("action"),
+                    np.getInt("id", -1),
+                    parsePoints(np.getString("points", "")),
+                    start
+                )
+            }
+            KIND_TAP -> RemoteTouchInjector.tap(np.getDouble("x").toFloat(), np.getDouble("y").toFloat())
+            KIND_SWIPE -> RemoteTouchInjector.swipe(
+                parsePoints(np.getString("points", "").split(';').mapIndexed { i, p -> "$i,$p" }.joinToString(";"))
+                    .values.toList(),
+                np.getInt("duration", 100).toLong()
+            )
+            KIND_GLOBAL -> RemoteTouchInjector.globalAction(np.getString("name"))
+            else -> return false
+        }
+        return true
+    }
+
+    private fun parsePoints(text: String): Map<Int, Pair<Float, Float>> {
+        val result = LinkedHashMap<Int, Pair<Float, Float>>()
+        for (entry in text.split(';')) {
+            val parts = entry.split(',')
+            if (parts.size != 3) continue
+            val id = parts[0].toIntOrNull() ?: continue
+            val x = parts[1].toFloatOrNull() ?: continue
+            val y = parts[2].toFloatOrNull() ?: continue
+            result[id] = x to y
+        }
+        return result
+    }
+
+    private fun startSharing(parentActivity: Activity) {
+        val settings = ScreenShareSettings(context)
+        parentActivity.startActivity(
+            Intent(parentActivity, ScreenCaptureConsentActivity::class.java)
+                .putExtra(ScreenCaptureConsentActivity.EXTRA_DEVICE_ID, device.deviceId)
+                .putExtra(ScreenCaptureConsentActivity.EXTRA_PRESET, settings.preset.name)
+                .putExtra(ScreenCaptureConsentActivity.EXTRA_AUTO_STOP_MINUTES, settings.autoStopMinutes)
+                .putExtra(ScreenCaptureConsentActivity.EXTRA_SOUND, settings.soundEnabled)
+        )
+    }
+
+    /**
+     * Android only lets us ask for the screen capture consent from a visible activity, so another
+     * device can't start sharing by itself: we ask the user to confirm with a tap on a notification.
+     */
+    private fun showShareRequest(preset: ScreenPreset, autoStopMinutes: Int, sound: Boolean) {
+        if (!notificationsAllowed()) {
+            toast(R.string.screenshare_share_open_app_hint, device.name)
+            return
+        }
+
+        val consentIntent = Intent(context, ScreenCaptureConsentActivity::class.java)
+            .putExtra(ScreenCaptureConsentActivity.EXTRA_DEVICE_ID, device.deviceId)
+            .putExtra(ScreenCaptureConsentActivity.EXTRA_PRESET, preset.name)
+            .putExtra(ScreenCaptureConsentActivity.EXTRA_AUTO_STOP_MINUTES, autoStopMinutes)
+            .putExtra(ScreenCaptureConsentActivity.EXTRA_SOUND, sound)
+            .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
+        val pendingIntent = PendingIntent.getActivity(
+            context,
+            device.deviceId.hashCode() xor 0x53,
+            consentIntent,
+            PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE
+        )
+        val notification = NotificationCompat.Builder(context, NotificationHelper.Channels.HIGHPRIORITY)
+            .setSmallIcon(R.drawable.ic_notification)
+            .setContentTitle(context.getString(R.string.screenshare_request_title, device.name))
+            .setContentText(context.getString(R.string.screenshare_request_text))
+            .setContentIntent(pendingIntent)
+            .setAutoCancel(true)
+            .setPriority(NotificationCompat.PRIORITY_HIGH)
+            .build()
+        context.getSystemService<NotificationManager>()!!.notify(device.deviceId.hashCode() xor 0x53, notification)
+    }
+
+    private fun notificationsAllowed(): Boolean =
+        Build.VERSION.SDK_INT < Build.VERSION_CODES.TIRAMISU ||
+            ContextCompat.checkSelfPermission(context, Manifest.permission.POST_NOTIFICATIONS) == PackageManager.PERMISSION_GRANTED
+
+    // -- UI -----------------------------------------------------------------------------------
+
+    override fun getUiButtons(): List<PluginUiButton> = listOf(
+        PluginUiButton(context.getString(R.string.screenshare_view), R.drawable.ic_phonelink_36dp) { activity ->
+            activity.startActivity(
+                Intent(activity, ScreenViewerActivity::class.java)
+                    .putExtra(ScreenViewerActivity.EXTRA_DEVICE_ID, device.deviceId)
+                    .putExtra(ScreenViewerActivity.EXTRA_AUTO_REQUEST, true)
+            )
+        },
+        PluginUiButton(context.getString(R.string.screenshare_share_here), R.drawable.ic_phonelink_36dp) { activity ->
+            startSharing(activity)
+        },
+    )
+
+    override fun getUiMenuEntries(): List<PluginUiMenuEntry> = listOf(
+        PluginUiMenuEntry(context.getString(R.string.screenshare_stop)) {
+            requestStop()
+            ScreenShareState.stopIfSharingWith(device.deviceId)
+        }
+    )
+
+    private fun toast(@StringRes message: Int, vararg formatArgs: Any) {
+        Handler(Looper.getMainLooper()).post {
+            Toast.makeText(context, context.getString(message, *formatArgs), Toast.LENGTH_LONG).show()
+        }
+    }
+
+    companion object {
+        const val PACKET_TYPE_SCREENSHARE = "kdeconnect.screenshare"
+        const val PACKET_TYPE_SCREENSHARE_REQUEST = "kdeconnect.screenshare.request"
+        const val PACKET_TYPE_SCREENSHARE_CONTROL = "kdeconnect.screenshare.control"
+
+        const val CODEC_H264 = "h264"
+
+        private const val ACTION_START = "start"
+        private const val ACTION_STOP = "stop"
+        private const val ACTION_KEYFRAME = "keyframe"
+        private const val ACTION_BITRATE = "bitrate"
+        private const val ACTION_PING = "ping"
+        private const val ACTION_PONG = "pong"
+        private const val ACTION_CONTROL_UNAVAILABLE = "control_unavailable"
+        private const val ACTION_GESTURE_RESULT = "gesture_result"
+
+        private const val KIND_TOUCH = "touch"
+        private const val KIND_TAP = "tap"
+        private const val KIND_SWIPE = "swipe"
+        private const val KIND_GLOBAL = "global"
+
+        private const val UNAVAILABLE_NOTICE_INTERVAL_MS = 5000L
+
+        private const val LOG_TAG = "ScreenSharePlugin"
+    }
+}
