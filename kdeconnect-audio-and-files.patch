+/*
+ * SPDX-FileCopyrightText: 2026 KDE Connect contributors
+ *
+ * SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+package org.kde.kdeconnect.plugins.audiostream
+
+import android.Manifest
+import android.content.Intent
+import android.content.pm.PackageManager
+import android.media.projection.MediaProjectionManager
+import android.os.Build
+import android.os.Bundle
+import android.widget.Toast
+import androidx.activity.ComponentActivity
+import androidx.activity.result.contract.ActivityResultContracts
+import androidx.annotation.StringRes
+import androidx.core.content.ContextCompat
+import androidx.core.content.getSystemService
+import org.kde.kdeconnect_tp.R
+
+/**
+ * Invisible activity that collects what Android requires before an app can capture the audio
+ * played by other apps: the microphone permission and the screen capture consent dialog.
+ * Once both are granted, it hands over to [AudioCaptureService].
+ */
+class AudioCaptureConsentActivity : ComponentActivity() {
+
+    private lateinit var deviceId: String
+
+    private val recordAudioLauncher = registerForActivityResult(ActivityResultContracts.RequestPermission()) { granted ->
+        if (granted) launchProjectionDialog() else fail(R.string.audiostream_permission_denied)
+    }
+
+    private val projectionLauncher = registerForActivityResult(ActivityResultContracts.StartActivityForResult()) { result ->
+        val data = result.data
+        if (result.resultCode == RESULT_OK && data != null) {
+            startCapture(result.resultCode, data)
+        } else {
+            fail(R.string.audiostream_consent_denied)
+        }
+    }
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+
+        val id = intent.getStringExtra(EXTRA_DEVICE_ID)
+        if (id == null || Build.VERSION.SDK_INT < Build.VERSION_CODES.Q) {
+            fail(R.string.audiostream_unsupported)
+            return
+        }
+        deviceId = id
+
+        // After a configuration change the launchers above deliver their pending result on their own
+        if (savedInstanceState != null) return
+
+        val hasPermission = ContextCompat.checkSelfPermission(this, Manifest.permission.RECORD_AUDIO) ==
+            PackageManager.PERMISSION_GRANTED
+        if (hasPermission) {
+            launchProjectionDialog()
+        } else {
+            recordAudioLauncher.launch(Manifest.permission.RECORD_AUDIO)
+        }
+    }
+
+    private fun launchProjectionDialog() {
+        val manager = getSystemService<MediaProjectionManager>()
+        if (manager == null) {
+            fail(R.string.audiostream_unsupported)
+            return
+        }
+        // Tip for the user: if the shared audio is silent, choose to share the entire screen,
+        // since sharing a single app limits which audio can be captured on recent Android versions.
+        projectionLauncher.launch(manager.createScreenCaptureIntent())
+    }
+
+    private fun startCapture(resultCode: Int, data: Intent) {
+        val serviceIntent = Intent(this, AudioCaptureService::class.java)
+            .putExtra(AudioCaptureService.EXTRA_DEVICE_ID, deviceId)
+            .putExtra(AudioCaptureService.EXTRA_RESULT_CODE, resultCode)
+            .putExtra(AudioCaptureService.EXTRA_RESULT_DATA, data)
+        ContextCompat.startForegroundService(this, serviceIntent)
+        finish()
+    }
+
+    private fun fail(@StringRes message: Int) {
+        Toast.makeText(this, message, Toast.LENGTH_LONG).show()
+        finish()
+    }
+
+    companion object {
+        const val EXTRA_DEVICE_ID = "deviceId"
+    }
+}
diff --git a/src/main/java/org/kde/kdeconnect/plugins/audiostream/AudioCaptureService.kt b/src/main/java/org/kde/kdeconnect/plugins/audiostream/AudioCaptureService.kt
