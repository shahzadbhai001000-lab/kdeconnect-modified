+/*
+ * SPDX-FileCopyrightText: 2026 KDE Connect contributors
+ *
+ * SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+package org.kde.kdeconnect.plugins.audiostream
+
+import android.Manifest
+import android.app.NotificationManager
+import android.app.PendingIntent
+import android.content.Intent
+import android.content.pm.PackageManager
+import android.os.Build
+import android.os.Handler
+import android.os.Looper
+import android.util.Log
+import android.widget.Toast
+import androidx.annotation.StringRes
+import androidx.core.app.NotificationCompat
+import androidx.core.content.ContextCompat
+import androidx.core.content.getSystemService
+import org.kde.kdeconnect.NetworkPacket
+import org.kde.kdeconnect.helpers.NotificationHelper
+import org.kde.kdeconnect.plugins.Plugin
+import org.kde.kdeconnect.plugins.PluginFactory.LoadablePlugin
+import org.kde.kdeconnect_tp.R
+
+/**
+ * Streams the audio output of one phone to another, live.
+ *
+ * - Sending ("Send this phone's audio here") needs Android 10+, because that is when Android
+ *   started letting apps capture the audio played by other apps.
+ * - Receiving ("Play its audio on this phone") works on any Android version.
+ *
+ * The audio travels as raw 16-bit PCM through the payload of a `kdeconnect.audiostream` packet, over
+ * the same encrypted connection used by the rest of KDE Connect.
+ */
+@LoadablePlugin
+class AudioStreamPlugin : Plugin() {
+
+    override val displayName: String
+        get() = context.getString(R.string.pref_plugin_audiostream)
+
+    override val description: String
+        get() = context.getString(R.string.pref_plugin_audiostream_desc)
+
+    override val supportedPacketTypes: Array<String> = arrayOf(PACKET_TYPE_AUDIOSTREAM, PACKET_TYPE_AUDIOSTREAM_REQUEST)
+
+    override val outgoingPacketTypes: Array<String> = arrayOf(PACKET_TYPE_AUDIOSTREAM, PACKET_TYPE_AUDIOSTREAM_REQUEST)
+
+    private var player: AudioStreamPlayer? = null
+
+    private val canCaptureAudio: Boolean
+        get() = Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q
+
+    override fun onDestroy() {
+        stopPlayback()
+        AudioShareState.stopIfSharingWith(device.deviceId)
+    }
+
+    override fun onPacketReceived(np: NetworkPacket): Boolean {
+        return when (np.type) {
+            PACKET_TYPE_AUDIOSTREAM -> handleIncomingStream(np)
+            PACKET_TYPE_AUDIOSTREAM_REQUEST -> handleRequest(np)
+            else -> false
+        }
+    }
+
+    // -- Receiving ----------------------------------------------------------------------------
+
+    private fun handleIncomingStream(np: NetworkPacket): Boolean {
+        if (np.has("error")) {
+            np.payload?.close()
+            toast(R.string.audiostream_unsupported_remote, device.name)
+            return true
+        }
+
+        val payload = np.payload
+        if (payload == null) {
+            Log.w(LOG_TAG, "Received an audio stream without data")
+            return false
+        }
+
+        val sampleRate = np.getInt("sampleRate", DEFAULT_SAMPLE_RATE)
+        val channels = np.getInt("channels", DEFAULT_CHANNELS)
+        val encoding = np.getString("encoding", ENCODING_PCM_S16LE)
+        if (encoding != ENCODING_PCM_S16LE || sampleRate !in 8000..192000 || channels !in 1..2) {
+            Log.w(LOG_TAG, "Unsupported audio stream: $encoding, $sampleRate Hz, $channels channels")
+            payload.close()
+            return false
+        }
+
+        stopPlayback()
+        val newPlayer = AudioStreamPlayer(sampleRate, channels, payload) { finished ->
+            // Only forget the player if it wasn't already replaced by a newer stream
+            synchronized(this) { if (player === finished) player = null }
+        }
+        synchronized(this) { player = newPlayer }
+        newPlayer.start()
+        toast(R.string.audiostream_playing, device.name)
+        return true
+    }
+
+    private fun stopPlayback() {
+        val current = synchronized(this) { player.also { player = null } }
+        current?.stop()
+    }
+
+    private fun requestRemoteAudio() {
+        device.sendPacket(NetworkPacket(PACKET_TYPE_AUDIOSTREAM_REQUEST).apply { this["action"] = ACTION_START })
+        toast(R.string.audiostream_waiting, device.name)
+    }
+
+    private fun stopListening() {
+        stopPlayback()
+        device.sendPacket(NetworkPacket(PACKET_TYPE_AUDIOSTREAM_REQUEST).apply { this["action"] = ACTION_STOP })
+    }
+
+    // -- Sending ------------------------------------------------------------------------------
+
+    private fun handleRequest(np: NetworkPacket): Boolean {
+        when (np.getString("action")) {
+            ACTION_START -> {
+                if (!canCaptureAudio) {
+                    device.sendPacket(NetworkPacket(PACKET_TYPE_AUDIOSTREAM).apply {
+                        this["error"] = ERROR_UNSUPPORTED_ANDROID_VERSION
+                    })
+                } else {
+                    showShareRequest()
+                }
+            }
+            ACTION_STOP -> AudioShareState.stopIfSharingWith(device.deviceId)
+            else -> return false
+        }
+        return true
+    }
+
+    private fun startSharing(parentActivity: android.app.Activity) {
+        parentActivity.startActivity(
+            Intent(parentActivity, AudioCaptureConsentActivity::class.java)
+                .putExtra(AudioCaptureConsentActivity.EXTRA_DEVICE_ID, device.deviceId)
+        )
+    }
+
+    /**
+     * Android only lets us start capturing audio from a visible activity, so another device can't
+     * start the stream by itself: we ask the user to confirm with a tap on a notification.
+     */
+    private fun showShareRequest() {
+        val notificationsAllowed = Build.VERSION.SDK_INT < Build.VERSION_CODES.TIRAMISU ||
+            ContextCompat.checkSelfPermission(context, Manifest.permission.POST_NOTIFICATIONS) == PackageManager.PERMISSION_GRANTED
+        if (!notificationsAllowed) {
+            toast(R.string.audiostream_open_app_hint, device.name)
+            return
+        }
+
+        val consentIntent = Intent(context, AudioCaptureConsentActivity::class.java)
+            .putExtra(AudioCaptureConsentActivity.EXTRA_DEVICE_ID, device.deviceId)
+        val pendingIntent = PendingIntent.getActivity(
+            context,
+            device.deviceId.hashCode(),
+            consentIntent,
+            PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE
+        )
+        val notification = NotificationCompat.Builder(context, NotificationHelper.Channels.HIGHPRIORITY)
+            .setSmallIcon(R.drawable.ic_notification)
+            .setContentTitle(context.getString(R.string.audiostream_request_title, device.name))
+            .setContentText(context.getString(R.string.audiostream_request_text))
+            .setContentIntent(pendingIntent)
+            .setAutoCancel(true)
+            .setPriority(NotificationCompat.PRIORITY_HIGH)
+            .build()
+        context.getSystemService<NotificationManager>()!!.notify(device.deviceId.hashCode(), notification)
+    }
+
+    // -- UI -----------------------------------------------------------------------------------
+
+    override fun getUiButtons(): List<PluginUiButton> = buildList {
+        if (canCaptureAudio) {
+            add(PluginUiButton(context.getString(R.string.audiostream_send_here), R.drawable.ic_volume) { activity ->
+                startSharing(activity)
+            })
+        }
+        add(PluginUiButton(context.getString(R.string.audiostream_listen), R.drawable.ic_volume) {
+            requestRemoteAudio()
+        })
+    }
+
+    override fun getUiMenuEntries(): List<PluginUiMenuEntry> = listOf(
+        PluginUiMenuEntry(context.getString(R.string.audiostream_stop)) {
+            stopListening()
+            AudioShareState.stopIfSharingWith(device.deviceId)
+        }
+    )
+
+    private fun toast(@StringRes message: Int, vararg formatArgs: Any) {
+        Handler(Looper.getMainLooper()).post {
+            Toast.makeText(context, context.getString(message, *formatArgs), Toast.LENGTH_LONG).show()
+        }
+    }
+
+    companion object {
+        const val PACKET_TYPE_AUDIOSTREAM = "kdeconnect.audiostream"
+        const val PACKET_TYPE_AUDIOSTREAM_REQUEST = "kdeconnect.audiostream.request"
+
+        const val ENCODING_PCM_S16LE = "pcm_s16le"
+
+        private const val ACTION_START = "start"
+        private const val ACTION_STOP = "stop"
+        private const val ERROR_UNSUPPORTED_ANDROID_VERSION = "unsupported_android_version"
+
+        private const val DEFAULT_SAMPLE_RATE = 48000
+        private const val DEFAULT_CHANNELS = 2
+
+        private const val LOG_TAG = "AudioStreamPlugin"
+    }
+}
diff --git a/src/main/java/org/kde/kdeconnect/plugins/audiostream/PcmPipeInputStream.kt b/src/main/java/org/kde/kdeconnect/plugins/audiostream/PcmPipeInputStream.kt
new file mode 100644
index 00000000..f8ad89ee
--- /dev/null
+++ b/src/main/java/org/kde/kdeconnect/plugins/audiostream/PcmPipeInputStream.kt
@@ -0,0 +1,99 @@
+/*
+ * SPDX-FileCopyrightText: 2026 KDE Connect contributors
+ *
+ * SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+package org.kde.kdeconnect.plugins.audiostream
+
+import java.io.InputStream
+import java.util.concurrent.LinkedBlockingQueue
+import java.util.concurrent.atomic.AtomicBoolean
+
+/**
+ * An [InputStream] fed in real time by the audio capture thread and drained by the payload
+ * sender (see LanLink.sendPayload).
+ *
+ * The queue is bounded: when the network can't keep up, the oldest audio is dropped so the
+ * stream never falls further and further behind what is playing on the sending phone.
+ *
+ * [onClosed] is called when the consumer closes the stream (the other phone stopped listening,
+ * the connection dropped or it never connected), so the capture can be stopped.
+ */
+internal class PcmPipeInputStream(private val onClosed: () -> Unit) : InputStream() {
+
+    private val queue = LinkedBlockingQueue<ByteArray>(MAX_QUEUED_CHUNKS)
+    private val finished = AtomicBoolean(false)
+
+    // Only touched by the single consumer thread
+    private var current: ByteArray = EMPTY
+    private var position = 0
+    private var reachedEnd = false
+    private var firstRead = true
+
+    /** Called by the capture thread. Never blocks. */
+    fun push(chunk: ByteArray) {
+        if (finished.get()) return
+        while (!queue.offer(chunk)) {
+            queue.poll() // Drop the oldest chunk to make room
+            if (finished.get()) return
+        }
+    }
+
+    /** Ends the stream. The consumer sees end-of-stream as soon as it asks for more data. */
+    fun finish() {
+        if (finished.compareAndSet(false, true)) {
+            queue.clear()
+            queue.offer(END_OF_STREAM)
+        }
+    }
+
+    override fun read(): Int {
+        val single = ByteArray(1)
+        return if (read(single, 0, 1) < 0) -1 else single[0].toInt() and 0xFF
+    }
+
+    override fun read(buffer: ByteArray, offset: Int, length: Int): Int {
+        if (length == 0) return 0
+        if (reachedEnd) return -1
+
+        if (firstRead) {
+            // The consumer starts reading once the other phone has connected. Anything captured
+            // before that is stale, so skip it to keep the latency as low as possible.
+            firstRead = false
+            queue.clear()
+        }
+
+        if (position >= current.size) {
+            val next = try {
+                queue.take()
+            } catch (e: InterruptedException) {
+                Thread.currentThread().interrupt()
+                reachedEnd = true
+                return -1
+            }
+            if (next === END_OF_STREAM) {
+                reachedEnd = true
+                return -1
+            }
+            current = next
+            position = 0
+        }
+
+        val count = minOf(length, current.size - position)
+        System.arraycopy(current, position, buffer, offset, count)
+        position += count
+        return count
+    }
+
+    override fun close() {
+        finish()
+        onClosed()
+    }
+
+    private companion object {
+        // 50 chunks of 20 ms = at most one second of buffered audio
+        const val MAX_QUEUED_CHUNKS = 50
+        val EMPTY = ByteArray(0)
+        val END_OF_STREAM = ByteArray(0)
+    }
+}
diff --git a/src/main/java/org/kde/kdeconnect/plugins/screenshare/RemoteTouchInjector.kt b/src/main/java/org/kde/kdeconnect/plugins/screenshare/RemoteTouchInjector.kt
new file mode 100644
index 00000000..f5e25daf
--- /dev/null
+++ b/src/main/java/org/kde/kdeconnect/plugins/screenshare/RemoteTouchInjector.kt
@@ -0,0 +1,282 @@
+/*
+ * SPDX-FileCopyrightText: 2026 KDE Connect contributors
+ *
+ * SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+package org.kde.kdeconnect.plugins.screenshare
+
+import android.accessibilityservice.AccessibilityService
+import android.accessibilityservice.GestureDescription
+import android.graphics.Path
+import android.os.Build
+import android.os.Handler
+import android.os.Looper
+import android.os.SystemClock
+import android.util.DisplayMetrics
+import android.util.Log
+import android.view.WindowManager
+import androidx.core.content.getSystemService
+import org.kde.kdeconnect.KdeConnectAccessibilityService
+import java.util.ArrayDeque
+
+/**
+ * Replays the touches of the viewing phone on this phone, using KDE Connect's accessibility
+ * service (the same one used by the remote mouse), which the user has to turn on once in
+ * Android's Accessibility settings.
+ *
+ * Android only accepts finished gestures, so there are two ways to send a touch:
+ *
+ * - **Complete gestures** ([tap] and [swipe]): the viewer already knows the whole gesture, so it
+ *   is performed in one piece with the exact duration. A tap is a clean 45 ms touch, so it can
+ *   never turn into a long press, and a flick keeps its speed, so scrolling flings work.
+ * - **Live touches** ([touch]): for drags, long presses and several fingers. A finger that stays
+ *   down is sent as a chain of short strokes, each one "continuing" the previous one.
+ *   Several fingers are several strokes in the same gesture, which makes pinch work.
+ *
+ * Needs Android 7 (API 24) for gestures and Android 8 (API 26) for continued strokes.
+ */
+internal object RemoteTouchInjector {
+
+    private const val LOG_TAG = "RemoteTouchInjector"
+    private const val CHUNK_MS = 50L
+    private const val TAP_MS = 60L
+    private const val STUCK_AFTER_MS = 1500L
+    private const val MAX_QUEUED_SHOTS = 20
+
+    private class Pointer(var lastX: Float, var lastY: Float, var targetX: Float, var targetY: Float) {
+        var stroke: GestureDescription.StrokeDescription? = null
+        var ending = false
+    }
+
+    /** A gesture that is already complete: points in pixels and how long it takes. */
+    private class OneShot(val points: List<Pair<Float, Float>>, val durationMs: Long, val label: String)
+
+    private val handler = Handler(Looper.getMainLooper())
+
+    /** Told how each tap and swipe went ("tap ok 70ms", "swipe cancelled"...), to help find problems. */
+    @Volatile
+    var onResult: ((String) -> Unit)? = null
+
+    // All of the state below is only touched on the main thread
+    private val pointers = LinkedHashMap<Int, Pointer>()
+    private val oneShots = ArrayDeque<OneShot>()
+    private var dispatching = false
+    private var dispatchedAt = 0L
+
+    /** True when this phone can perform touches: Android 7+ and the accessibility service is on. */
+    val isAvailable: Boolean
+        get() = Build.VERSION.SDK_INT >= Build.VERSION_CODES.N && KdeConnectAccessibilityService.instance != null
+
+    /** A quick touch at ([x], [y]), both between 0 and 1. */
+    fun tap(x: Float, y: Float) {
+        handler.post {
+            val size = screenSize() ?: return@post
+            enqueue(OneShot(listOf(x.coerceIn(0f, 1f) * size.first to y.coerceIn(0f, 1f) * size.second), TAP_MS, "tap"))
+        }
+    }
+
+    /** A finished swipe through [points] (each between 0 and 1) that took [durationMs]. */
+    fun swipe(points: List<Pair<Float, Float>>, durationMs: Long) {
+        if (points.isEmpty()) return
+        handler.post {
+            val size = screenSize() ?: return@post
+            val pixels = points.map { it.first.coerceIn(0f, 1f) * size.first to it.second.coerceIn(0f, 1f) * size.second }
+            enqueue(OneShot(pixels, durationMs.coerceIn(1L, 2000L), "swipe"))
+        }
+    }
+
+    /**
+     * Live touch of one or more fingers.
+     * @param action "down", "move", "up" or "cancel"
+     * @param changedId the finger that went down or up (ignored for the other actions)
+     * @param points every finger currently on the screen, as id to (x, y) between 0 and 1
+     * @param start where the finger that went down really started, when it has already moved
+     */
+    fun touch(action: String, changedId: Int, points: Map<Int, Pair<Float, Float>>, start: Pair<Float, Float>? = null) {
+        handler.post { processTouch(action, changedId, points, start) }
+    }
+
+    /** @param name "back", "home", "recents", "notifications" or "power" */
+    fun globalAction(name: String) {
+        val action = when (name) {
+            "back" -> AccessibilityService.GLOBAL_ACTION_BACK
+            "home" -> AccessibilityService.GLOBAL_ACTION_HOME
+            "recents" -> AccessibilityService.GLOBAL_ACTION_RECENTS
+            "notifications" -> AccessibilityService.GLOBAL_ACTION_NOTIFICATIONS
+            "power" -> AccessibilityService.GLOBAL_ACTION_POWER_DIALOG
+            else -> return
+        }
+        handler.post { KdeConnectAccessibilityService.instance?.performGlobalAction(action) }
+    }
+
+    @Suppress("DEPRECATION") // Display.getRealMetrics is the only way to get the full size on API < 30
+    private fun screenSize(): Pair<Float, Float>? {
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.N) return null
+        val service = KdeConnectAccessibilityService.instance ?: return null
+        val metrics = DisplayMetrics()
+        service.getSystemService<WindowManager>()?.defaultDisplay?.getRealMetrics(metrics)
+        if (metrics.widthPixels <= 0 || metrics.heightPixels <= 0) return null
+        return metrics.widthPixels.toFloat() to metrics.heightPixels.toFloat()
+    }
+
+    private fun enqueue(shot: OneShot) {
+        val service = KdeConnectAccessibilityService.instance ?: return
+        unstickIfNeeded()
+        if (oneShots.size >= MAX_QUEUED_SHOTS) oneShots.poll()
+        oneShots.add(shot)
+        pump(service)
+    }
+
+    private fun unstickIfNeeded() {
+        if (dispatching && SystemClock.uptimeMillis() - dispatchedAt > STUCK_AFTER_MS) {
+            // A gesture never reported back: start over instead of staying blocked forever
+            dispatching = false
+            pointers.clear()
+        }
+    }
+
+    private fun processTouch(action: String, changedId: Int, points: Map<Int, Pair<Float, Float>>, start: Pair<Float, Float>?) {
+        val service = KdeConnectAccessibilityService.instance ?: return
+        val size = screenSize() ?: return
+        val width = size.first
+        val height = size.second
+        unstickIfNeeded()
+
+        when (action) {
+            "down" -> {
+                val point = points[changedId] ?: return
+                val targetX = point.first.coerceIn(0f, 1f) * width
+                val targetY = point.second.coerceIn(0f, 1f) * height
+                // If the finger already moved before we heard of it, the first piece of the
+                // stroke goes from where it started to where it is now
+                val fromX = start?.first?.coerceIn(0f, 1f)?.times(width) ?: targetX
+                val fromY = start?.second?.coerceIn(0f, 1f)?.times(height) ?: targetY
+                pointers[changedId] = Pointer(fromX, fromY, targetX, targetY)
+            }
+            "move" -> for ((id, point) in points) {
+                pointers[id]?.let {
+                    it.targetX = point.first.coerceIn(0f, 1f) * width
+                    it.targetY = point.second.coerceIn(0f, 1f) * height
+                }
+            }
+            "up" -> {
+                pointers[changedId]?.let { pointer ->
+                    points[changedId]?.let {
+                        pointer.targetX = it.first.coerceIn(0f, 1f) * width
+                        pointer.targetY = it.second.coerceIn(0f, 1f) * height
+                    }
+                    pointer.ending = true
+                }
+            }
+            "cancel" -> pointers.values.forEach { it.ending = true }
+            else -> return
+        }
+        pump(service)
+    }
+
+    /** Sends the next gesture. Live fingers come first, then complete gestures in order. */
+    private fun pump(service: KdeConnectAccessibilityService) {
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.N) return
+        if (dispatching) return
+
+        if (pointers.isNotEmpty()) {
+            dispatchLive(service)
+            return
+        }
+        val shot = oneShots.poll() ?: return
+        dispatchShot(service, shot)
+    }
+
+    private fun dispatchShot(service: KdeConnectAccessibilityService, shot: OneShot) {
+        val path = Path()
+        shot.points.forEachIndexed { index, point ->
+            if (index == 0) path.moveTo(point.first, point.second) else path.lineTo(point.first, point.second)
+        }
+        val gesture = GestureDescription.Builder()
+            .addStroke(GestureDescription.StrokeDescription(path, 0, shot.durationMs))
+            .build()
+        send(service, gesture, clearLiveOnCancel = false, label = shot.label)
+    }
+
+    /** Sends the next short piece of every finger that is down. Runs again when it completes. */
+    private fun dispatchLive(service: KdeConnectAccessibilityService) {
+        val builder = GestureDescription.Builder()
+        val maxStrokes = GestureDescription.getMaxStrokeCount()
+        val finished = ArrayList<Int>()
+        var count = 0
+        for ((id, pointer) in pointers) {
+            if (count >= maxStrokes) break
+
+            val path = Path()
+            path.moveTo(pointer.lastX, pointer.lastY)
+            if (pointer.targetX != pointer.lastX || pointer.targetY != pointer.lastY) {
+                path.lineTo(pointer.targetX, pointer.targetY)
+            }
+
+            val stroke = buildStroke(pointer, path)
+            builder.addStroke(stroke)
+            pointer.stroke = stroke
+            pointer.lastX = pointer.targetX
+            pointer.lastY = pointer.targetY
+            if (pointer.ending) finished.add(id)
+            count++
+        }
+        if (count == 0) return
+
+        if (send(service, builder.build(), clearLiveOnCancel = true, label = null)) {
+            finished.forEach { pointers.remove(it) }
+        }
+    }
+
+    /** @return false if Android refused the gesture */
+    private fun send(
+        service: KdeConnectAccessibilityService,
+        gesture: GestureDescription,
+        clearLiveOnCancel: Boolean,
+        label: String?,
+    ): Boolean {
+        val callback = object : AccessibilityService.GestureResultCallback() {
+            override fun onCompleted(gestureDescription: GestureDescription?) {
+                dispatching = false
+                label?.let { onResult?.invoke("$it ok ${SystemClock.uptimeMillis() - dispatchedAt}ms") }
+                pump(service)
+            }
+
+            override fun onCancelled(gestureDescription: GestureDescription?) {
+                dispatching = false
+                label?.let { onResult?.invoke("$it cancelled") }
+                // The chain of live strokes is broken: the next touch starts fresh
+                if (clearLiveOnCancel) pointers.clear()
+                pump(service)
+            }
+        }
+        dispatching = true
+        dispatchedAt = SystemClock.uptimeMillis()
+        val accepted = try {
+            service.dispatchGesture(gesture, callback, handler)
+        } catch (e: Exception) {
+            Log.w(LOG_TAG, "Could not dispatch the gesture", e)
+            false
+        }
+        if (!accepted) {
+            dispatching = false
+            label?.let { onResult?.invoke("$it rejected") }
+            if (clearLiveOnCancel) pointers.clear()
+        }
+        return accepted
+    }
+
+    private fun buildStroke(pointer: Pointer, path: Path): GestureDescription.StrokeDescription {
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.O) {
+            // No continued strokes before Android 8: every piece is its own short stroke
+            return GestureDescription.StrokeDescription(path, 0, CHUNK_MS)
+        }
+        val willContinue = !pointer.ending
+        val previous = pointer.stroke
+        return if (previous == null) {
+            GestureDescription.StrokeDescription(path, 0, CHUNK_MS, willContinue)
+        } else {
+            previous.continueStroke(path, 0, CHUNK_MS, willContinue)
+        }
+    }
+}
diff --git a/src/main/java/org/kde/kdeconnect/plugins/screenshare/ScreenCaptureConsentActivity.kt b/src/main/java/org/kde/kdeconnect/plugins/screenshare/ScreenCaptureConsentActivity.kt
new file mode 100644
index 00000000..fd017f2e
--- /dev/null
+++ b/src/main/java/org/kde/kdeconnect/plugins/screenshare/ScreenCaptureConsentActivity.kt
@@ -0,0 +1,104 @@
+/*
+ * SPDX-FileCopyrightText: 2026 KDE Connect contributors
+ *
+ * SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+package org.kde.kdeconnect.plugins.screenshare
+
+import android.Manifest
+import android.content.Intent
+import android.content.pm.PackageManager
+import android.media.projection.MediaProjectionManager
+import android.os.Build
+import android.os.Bundle
+import android.widget.Toast
+import androidx.activity.ComponentActivity
+import androidx.activity.result.contract.ActivityResultContracts
+import androidx.annotation.StringRes
+import androidx.core.content.ContextCompat
+import androidx.core.content.getSystemService
+import org.kde.kdeconnect_tp.R
+
+/**
+ * Invisible activity that shows the screen capture consent dialog Android requires before an app
+ * can record the screen. Once granted, it hands over to [ScreenCaptureService].
+ */
+class ScreenCaptureConsentActivity : ComponentActivity() {
+
+    private lateinit var deviceId: String
+    private var preset: String = ScreenPreset.DEFAULT.name
+    private var autoStopMinutes: Int = 0
+    private var sound: Boolean = false
+
+    // The sound of the phone can only be captured with the microphone permission. If it is
+    // refused, the screen is still shared, just without sound.
+    private val audioPermissionLauncher = registerForActivityResult(ActivityResultContracts.RequestPermission()) { granted ->
+        sound = granted
+        launchProjectionDialog()
+    }
+
+    private val projectionLauncher = registerForActivityResult(ActivityResultContracts.StartActivityForResult()) { result ->
+        val data = result.data
+        if (result.resultCode == RESULT_OK && data != null) {
+            startCapture(result.resultCode, data)
+        } else {
+            fail(R.string.screenshare_consent_denied)
+        }
+    }
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+
+        val id = intent.getStringExtra(EXTRA_DEVICE_ID)
+        if (id == null) {
+            fail(R.string.screenshare_unsupported)
+            return
+        }
+        deviceId = id
+        preset = intent.getStringExtra(EXTRA_PRESET) ?: ScreenPreset.DEFAULT.name
+        autoStopMinutes = intent.getIntExtra(EXTRA_AUTO_STOP_MINUTES, 0)
+        sound = intent.getBooleanExtra(EXTRA_SOUND, true) && Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q
+
+        // After a configuration change the launcher delivers its pending result on its own
+        if (savedInstanceState != null) return
+
+        if (sound && ContextCompat.checkSelfPermission(this, Manifest.permission.RECORD_AUDIO) != PackageManager.PERMISSION_GRANTED) {
+            audioPermissionLauncher.launch(Manifest.permission.RECORD_AUDIO)
+        } else {
+            launchProjectionDialog()
+        }
+    }
+
+    private fun launchProjectionDialog() {
+        val manager = getSystemService<MediaProjectionManager>()
+        if (manager == null) {
+            fail(R.string.screenshare_unsupported)
+            return
+        }
+        projectionLauncher.launch(manager.createScreenCaptureIntent())
+    }
+
+    private fun startCapture(resultCode: Int, data: Intent) {
+        val serviceIntent = Intent(this, ScreenCaptureService::class.java)
+            .putExtra(ScreenCaptureService.EXTRA_DEVICE_ID, deviceId)
+            .putExtra(ScreenCaptureService.EXTRA_RESULT_CODE, resultCode)
+            .putExtra(ScreenCaptureService.EXTRA_RESULT_DATA, data)
+            .putExtra(ScreenCaptureService.EXTRA_PRESET, preset)
+            .putExtra(ScreenCaptureService.EXTRA_AUTO_STOP_MINUTES, autoStopMinutes)
+            .putExtra(ScreenCaptureService.EXTRA_SOUND, sound)
+        ContextCompat.startForegroundService(this, serviceIntent)
+        finish()
+    }
+
+    private fun fail(@StringRes message: Int) {
+        Toast.makeText(this, message, Toast.LENGTH_LONG).show()
+        finish()
+    }
+
+    companion object {
+        const val EXTRA_DEVICE_ID = "deviceId"
+        const val EXTRA_PRESET = "preset"
+        const val EXTRA_AUTO_STOP_MINUTES = "autoStopMinutes"
+        const val EXTRA_SOUND = "sound"
+    }
+}
