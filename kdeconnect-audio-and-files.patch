+++ b/src/main/java/org/kde/kdeconnect/plugins/audiostream/AudioStreamPlugin.kt
@@ -0,0 +1,217 @@
+/*
+ * SPDX-FileCopyrightText: 2026 KDE Connect contributors
+ *
+ * SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+package org.kde.kdeconnect.plugins.audiostream
+
+import android.Manifest
+import android.app.NotificationManager
+import android.app.PendingIntent
+import android.content.Intent
+import android.content.pm.PackageManager
+import android.os.Build
+import android.os.Handler
+import android.os.Looper
+import android.util.Log
+import android.widget.Toast
+import androidx.annotation.StringRes
+import androidx.core.app.NotificationCompat
+import androidx.core.content.ContextCompat
+import androidx.core.content.getSystemService
+import org.kde.kdeconnect.NetworkPacket
+import org.kde.kdeconnect.helpers.NotificationHelper
+import org.kde.kdeconnect.plugins.Plugin
+import org.kde.kdeconnect.plugins.PluginFactory.LoadablePlugin
+import org.kde.kdeconnect_tp.R
+
+/**
+ * Streams the audio output of one phone to another, live.
+ *
+ * - Sending ("Send this phone's audio here") needs Android 10+, because that is when Android
+ *   started letting apps capture the audio played by other apps.
+ * - Receiving ("Play its audio on this phone") works on any Android version.
+ *
+ * The audio travels as raw 16-bit PCM through the payload of a `kdeconnect.audiostream` packet, over
+ * the same encrypted connection used by the rest of KDE Connect.
+ */
+@LoadablePlugin
+class AudioStreamPlugin : Plugin() {
+
+    override val displayName: String
+        get() = context.getString(R.string.pref_plugin_audiostream)
+
+    override val description: String
+        get() = context.getString(R.string.pref_plugin_audiostream_desc)
+
+    override val supportedPacketTypes: Array<String> = arrayOf(PACKET_TYPE_AUDIOSTREAM, PACKET_TYPE_AUDIOSTREAM_REQUEST)
+
+    override val outgoingPacketTypes: Array<String> = arrayOf(PACKET_TYPE_AUDIOSTREAM, PACKET_TYPE_AUDIOSTREAM_REQUEST)
+
+    private var player: AudioStreamPlayer? = null
+
+    private val canCaptureAudio: Boolean
+        get() = Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q
+
+    override fun onDestroy() {
+        stopPlayback()
+        AudioShareState.stopIfSharingWith(device.deviceId)
+    }
+
+    override fun onPacketReceived(np: NetworkPacket): Boolean {
+        return when (np.type) {
+            PACKET_TYPE_AUDIOSTREAM -> handleIncomingStream(np)
+            PACKET_TYPE_AUDIOSTREAM_REQUEST -> handleRequest(np)
+            else -> false
+        }
+    }
+
+    // -- Receiving ----------------------------------------------------------------------------
+
+    private fun handleIncomingStream(np: NetworkPacket): Boolean {
+        if (np.has("error")) {
+            np.payload?.close()
+            toast(R.string.audiostream_unsupported_remote, device.name)
+            return true
+        }
+
+        val payload = np.payload
+        if (payload == null) {
+            Log.w(LOG_TAG, "Received an audio stream without data")
+            return false
+        }
+
+        val sampleRate = np.getInt("sampleRate", DEFAULT_SAMPLE_RATE)
+        val channels = np.getInt("channels", DEFAULT_CHANNELS)
+        val encoding = np.getString("encoding", ENCODING_PCM_S16LE)
+        if (encoding != ENCODING_PCM_S16LE || sampleRate !in 8000..192000 || channels !in 1..2) {
+            Log.w(LOG_TAG, "Unsupported audio stream: $encoding, $sampleRate Hz, $channels channels")
+            payload.close()
+            return false
+        }
+
+        stopPlayback()
+        val newPlayer = AudioStreamPlayer(sampleRate, channels, payload) { finished ->
+            // Only forget the player if it wasn't already replaced by a newer stream
+            synchronized(this) { if (player === finished) player = null }
+        }
+        synchronized(this) { player = newPlayer }
+        newPlayer.start()
+        toast(R.string.audiostream_playing, device.name)
+        return true
+    }
+
+    private fun stopPlayback() {
+        val current = synchronized(this) { player.also { player = null } }
+        current?.stop()
+    }
+
+    private fun requestRemoteAudio() {
+        device.sendPacket(NetworkPacket(PACKET_TYPE_AUDIOSTREAM_REQUEST).apply { this["action"] = ACTION_START })
+        toast(R.string.audiostream_waiting, device.name)
+    }
+
+    private fun stopListening() {
+        stopPlayback()
+        device.sendPacket(NetworkPacket(PACKET_TYPE_AUDIOSTREAM_REQUEST).apply { this["action"] = ACTION_STOP })
+    }
+
+    // -- Sending ------------------------------------------------------------------------------
+
+    private fun handleRequest(np: NetworkPacket): Boolean {
+        when (np.getString("action")) {
+            ACTION_START -> {
+                if (!canCaptureAudio) {
+                    device.sendPacket(NetworkPacket(PACKET_TYPE_AUDIOSTREAM).apply {
+                        this["error"] = ERROR_UNSUPPORTED_ANDROID_VERSION
+                    })
+                } else {
+                    showShareRequest()
+                }
+            }
+            ACTION_STOP -> AudioShareState.stopIfSharingWith(device.deviceId)
+            else -> return false
+        }
+        return true
+    }
+
+    private fun startSharing(parentActivity: android.app.Activity) {
+        parentActivity.startActivity(
+            Intent(parentActivity, AudioCaptureConsentActivity::class.java)
+                .putExtra(AudioCaptureConsentActivity.EXTRA_DEVICE_ID, device.deviceId)
+        )
+    }
+
+    /**
+     * Android only lets us start capturing audio from a visible activity, so another device can't
+     * start the stream by itself: we ask the user to confirm with a tap on a notification.
+     */
+    private fun showShareRequest() {
+        val notificationsAllowed = Build.VERSION.SDK_INT < Build.VERSION_CODES.TIRAMISU ||
+            ContextCompat.checkSelfPermission(context, Manifest.permission.POST_NOTIFICATIONS) == PackageManager.PERMISSION_GRANTED
+        if (!notificationsAllowed) {
+            toast(R.string.audiostream_open_app_hint, device.name)
+            return
+        }
+
+        val consentIntent = Intent(context, AudioCaptureConsentActivity::class.java)
+            .putExtra(AudioCaptureConsentActivity.EXTRA_DEVICE_ID, device.deviceId)
+        val pendingIntent = PendingIntent.getActivity(
+            context,
+            device.deviceId.hashCode(),
+            consentIntent,
+            PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE
+        )
+        val notification = NotificationCompat.Builder(context, NotificationHelper.Channels.HIGHPRIORITY)
+            .setSmallIcon(R.drawable.ic_notification)
+            .setContentTitle(context.getString(R.string.audiostream_request_title, device.name))
+            .setContentText(context.getString(R.string.audiostream_request_text))
+            .setContentIntent(pendingIntent)
+            .setAutoCancel(true)
+            .setPriority(NotificationCompat.PRIORITY_HIGH)
+            .build()
+        context.getSystemService<NotificationManager>()!!.notify(device.deviceId.hashCode(), notification)
+    }
+
+    // -- UI -----------------------------------------------------------------------------------
+
+    override fun getUiButtons(): List<PluginUiButton> = buildList {
+        if (canCaptureAudio) {
+            add(PluginUiButton(context.getString(R.string.audiostream_send_here), R.drawable.ic_volume) { activity ->
+                startSharing(activity)
+            })
+        }
+        add(PluginUiButton(context.getString(R.string.audiostream_listen), R.drawable.ic_volume) {
+            requestRemoteAudio()
+        })
+    }
+
+    override fun getUiMenuEntries(): List<PluginUiMenuEntry> = listOf(
+        PluginUiMenuEntry(context.getString(R.string.audiostream_stop)) {
+            stopListening()
+            AudioShareState.stopIfSharingWith(device.deviceId)
+        }
+    )
+
+    private fun toast(@StringRes message: Int, vararg formatArgs: Any) {
+        Handler(Looper.getMainLooper()).post {
+            Toast.makeText(context, context.getString(message, *formatArgs), Toast.LENGTH_LONG).show()
+        }
+    }
+
+    companion object {
+        const val PACKET_TYPE_AUDIOSTREAM = "kdeconnect.audiostream"
+        const val PACKET_TYPE_AUDIOSTREAM_REQUEST = "kdeconnect.audiostream.request"
+
+        const val ENCODING_PCM_S16LE = "pcm_s16le"
+
+        private const val ACTION_START = "start"
+        private const val ACTION_STOP = "stop"
+        private const val ERROR_UNSUPPORTED_ANDROID_VERSION = "unsupported_android_version"
+
+        private const val DEFAULT_SAMPLE_RATE = 48000
+        private const val DEFAULT_CHANNELS = 2
+
+        private const val LOG_TAG = "AudioStreamPlugin"
+    }
+}
