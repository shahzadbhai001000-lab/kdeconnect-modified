new file mode 100644
index 00000000..7d6a9876
--- /dev/null
+++ b/src/main/java/org/kde/kdeconnect/plugins/screenshare/ScreenShareState.kt
@@ -0,0 +1,83 @@
+/*
+ * SPDX-FileCopyrightText: 2026 KDE Connect contributors
+ *
+ * SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+package org.kde.kdeconnect.plugins.screenshare
+
+import org.kde.kdeconnect.NetworkPacket
+
+/** What the viewer needs to know about an incoming video stream. */
+internal data class StreamHeader(val width: Int, val height: Int, val fps: Int, val bitrate: Int)
+
+/**
+ * Process-wide state of screen sharing: which device this phone is sharing with (sharing side),
+ * and where an incoming stream should go (viewing side).
+ */
+internal object ScreenShareState {
+
+    // -- Sharing side -------------------------------------------------------------------------
+
+    class HostActions(
+        val stop: () -> Unit,
+        val setBitrate: (Int) -> Unit,
+        val requestKeyframe: () -> Unit,
+    )
+
+    @Volatile
+    var activeDeviceId: String? = null
+        private set
+
+    @Volatile
+    private var hostActions: HostActions? = null
+
+    fun started(deviceId: String, actions: HostActions) {
+        activeDeviceId = deviceId
+        hostActions = actions
+    }
+
+    fun ended() {
+        activeDeviceId = null
+        hostActions = null
+    }
+
+    fun isSharingWith(deviceId: String): Boolean = activeDeviceId == deviceId
+
+    fun stopIfSharingWith(deviceId: String) {
+        if (activeDeviceId == deviceId) hostActions?.stop?.invoke()
+    }
+
+    fun setBitrateIfSharingWith(deviceId: String, bitrate: Int) {
+        if (activeDeviceId == deviceId) hostActions?.setBitrate?.invoke(bitrate)
+    }
+
+    fun requestKeyframeIfSharingWith(deviceId: String) {
+        if (activeDeviceId == deviceId) hostActions?.requestKeyframe?.invoke()
+    }
+
+    // -- Viewing side -------------------------------------------------------------------------
+
+    /** Set by the open viewer screen. Called on a background thread. */
+    @Volatile
+    var viewerListener: ((StreamHeader, NetworkPacket.Payload) -> Unit)? = null
+
+    private var pending: Pair<StreamHeader, NetworkPacket.Payload>? = null
+
+    /** Keeps a stream that arrived while no viewer was open, until the user opens it. */
+    @Synchronized
+    fun setPending(header: StreamHeader, payload: NetworkPacket.Payload) {
+        pending?.second?.close()
+        pending = header to payload
+    }
+
+    @Synchronized
+    fun takePending(): Pair<StreamHeader, NetworkPacket.Payload>? = pending.also { pending = null }
+
+    /** How the last tap or swipe went on the other phone, for the speed readout. */
+    @Volatile
+    var lastGestureResult: String = "-"
+
+    /** Last measured round trip to the other phone, in milliseconds, or -1. */
+    @Volatile
+    var lastRttMs: Long = -1L
+}
diff --git a/src/main/java/org/kde/kdeconnect/plugins/screenshare/ScreenStreamDecoder.kt b/src/main/java/org/kde/kdeconnect/plugins/screenshare/ScreenStreamDecoder.kt
new file mode 100644
index 00000000..aeb165d9
--- /dev/null
+++ b/src/main/java/org/kde/kdeconnect/plugins/screenshare/ScreenStreamDecoder.kt
@@ -0,0 +1,212 @@
+/*
+ * SPDX-FileCopyrightText: 2026 KDE Connect contributors
+ *
+ * SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+package org.kde.kdeconnect.plugins.screenshare
+
+import android.media.MediaCodec
+import android.media.MediaFormat
+import android.os.Build
+import android.util.Log
+import android.view.Surface
+import org.kde.kdeconnect.NetworkPacket
+import java.io.BufferedInputStream
+import java.io.DataInputStream
+import java.io.IOException
+import java.util.concurrent.atomic.AtomicBoolean
+import java.util.concurrent.atomic.AtomicLong
+
+/**
+ * Reads the video frames of a [NetworkPacket.Payload] and draws them on a [Surface].
+ *
+ * The stream keeps being read even while there is no surface (for example when the user switches
+ * to another app), so the session stays alive. The picture resumes at the next key frame when a
+ * surface comes back.
+ */
+internal class ScreenStreamDecoder(
+    private val header: StreamHeader,
+    private val payload: NetworkPacket.Payload,
+    private val onKeyframeNeeded: () -> Unit,
+    private val onEnded: (ScreenStreamDecoder) -> Unit,
+) {
+    /** Total bytes received, for the speed readout. */
+    val bytesReceived = AtomicLong()
+
+    /** Total frames drawn, for the fps readout. */
+    val framesDrawn = AtomicLong()
+
+    private val lock = Any()
+    private val ended = AtomicBoolean(false)
+
+    @Volatile
+    private var stopped = false
+
+    private var session: DecoderSession? = null
+    private var surface: Surface? = null
+    private var waitingForKey = true
+
+    fun start() {
+        Thread({ readLoop() }, "ScreenStreamReader").start()
+    }
+
+    /** Safe to call from any thread, and more than once. */
+    fun stop() {
+        stopped = true
+        // Closing the payload closes its socket, which unblocks a read() in progress
+        payload.close()
+    }
+
+    fun attachSurface(surface: Surface) {
+        val attached = synchronized(lock) {
+            this.surface = surface
+            startSessionLocked()
+        }
+        if (attached) onKeyframeNeeded()
+    }
+
+    fun detachSurface() {
+        synchronized(lock) {
+            surface = null
+            releaseSessionLocked()
+        }
+    }
+
+    /** Starts a new decoder on the current surface. Returns false if that is not possible. */
+    private fun startSessionLocked(): Boolean {
+        releaseSessionLocked()
+        val target = surface
+        if (stopped || target == null) return false
+        return try {
+            session = DecoderSession(target)
+            waitingForKey = true
+            true
+        } catch (e: Exception) {
+            Log.e(LOG_TAG, "Could not start the video decoder", e)
+            false
+        }
+    }
+
+    private inner class DecoderSession(surface: Surface) {
+        val codec: MediaCodec
+        private val thread: Thread
+
+        @Volatile
+        private var running = true
+
+        init {
+            val format = MediaFormat.createVideoFormat(MediaFormat.MIMETYPE_VIDEO_AVC, header.width, header.height)
+            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.R) {
+                format.setInteger(MediaFormat.KEY_LOW_LATENCY, 1)
+            }
+            val newCodec = MediaCodec.createDecoderByType(MediaFormat.MIMETYPE_VIDEO_AVC)
+            try {
+                newCodec.configure(format, surface, null, 0)
+                newCodec.start()
+            } catch (e: Exception) {
+                runCatching { newCodec.release() }
+                throw e
+            }
+            codec = newCodec
+            thread = Thread({ outputLoop() }, "ScreenStreamOutput").also { it.start() }
+        }
+
+        private fun outputLoop() {
+            val info = MediaCodec.BufferInfo()
+            while (running) {
+                val index = try {
+                    codec.dequeueOutputBuffer(info, 10_000)
+                } catch (e: Exception) {
+                    break
+                }
+                if (index >= 0) {
+                    // Draw right away: lowest delay
+                    runCatching { codec.releaseOutputBuffer(index, true) }
+                    framesDrawn.incrementAndGet()
+                }
+            }
+        }
+
+        fun release() {
+            running = false
+            runCatching { thread.join(300) }
+            runCatching { codec.stop() }
+            runCatching { codec.release() }
+        }
+    }
+
+    private fun releaseSessionLocked() {
+        session?.release()
+        session = null
+    }
+
+    private fun readLoop() {
+        try {
+            val input = DataInputStream(
+                BufferedInputStream(payload.inputStream ?: throw IOException("Screen stream has no data"), BUFFER_BYTES)
+            )
+            while (!stopped) {
+                val length = input.readInt()
+                val flags = input.readUnsignedByte()
+                input.readLong() // Presentation time, not needed to draw right away
+                if (length < 0 || length > MAX_FRAME_BYTES) throw IOException("Bad frame size: $length")
+                val data = ByteArray(length)
+                input.readFully(data)
+                bytesReceived.addAndGet(length + VideoPipeInputStream.HEADER_BYTES.toLong())
+                handleFrame(data, flags)
+            }
+        } catch (e: Exception) {
+            if (!stopped) Log.i(LOG_TAG, "Screen stream ended: ${e.message}")
+        } finally {
+            stopped = true
+            synchronized(lock) { releaseSessionLocked() }
+            payload.close()
+            if (ended.compareAndSet(false, true)) onEnded(this)
+        }
+    }
+
+    private fun handleFrame(data: ByteArray, flags: Int) {
+        val isConfig = flags and VideoPipeInputStream.FLAG_CONFIG != 0
+        val isKey = flags and VideoPipeInputStream.FLAG_KEY != 0
+
+        var restarted = false
+        synchronized(lock) {
+            val current = session ?: return // No surface right now: skip the frame
+            if (!isConfig && !isKey && waitingForKey) return // Can't start in the middle of a picture
+            if (isKey) waitingForKey = false
+
+            val codec = current.codec
+            try {
+                val index = codec.dequeueInputBuffer(INPUT_TIMEOUT_US)
+                if (index < 0) {
+                    // The decoder is behind: drop this frame and wait for the next key frame
+                    waitingForKey = true
+                    return
+                }
+                val buffer = codec.getInputBuffer(index)
+                if (buffer == null || buffer.capacity() < data.size) {
+                    codec.queueInputBuffer(index, 0, 0, 0, 0)
+                    waitingForKey = true
+                    return
+                }
+                buffer.clear()
+                buffer.put(data)
+                var codecFlags = 0
+                if (isConfig) codecFlags = codecFlags or MediaCodec.BUFFER_FLAG_CODEC_CONFIG
+                if (isKey) codecFlags = codecFlags or MediaCodec.BUFFER_FLAG_KEY_FRAME
+                codec.queueInputBuffer(index, 0, data.size, System.nanoTime() / 1000, codecFlags)
+            } catch (e: Exception) {
+                Log.w(LOG_TAG, "The video decoder failed, restarting it", e)
+                restarted = startSessionLocked()
+            }
+        }
+        if (restarted) onKeyframeNeeded()
+    }
+
+    private companion object {
+        const val LOG_TAG = "ScreenStreamDecoder"
+        const val BUFFER_BYTES = 64 * 1024
+        const val MAX_FRAME_BYTES = 16 * 1024 * 1024
+        const val INPUT_TIMEOUT_US = 100_000L
+    }
+}
