+/*
+ * SPDX-FileCopyrightText: 2026 KDE Connect contributors
+ *
+ * SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+package org.kde.kdeconnect.plugins.sftp
+
+import android.Manifest
+import android.content.pm.PackageManager
+import android.os.Build
+import android.os.Bundle
+import android.widget.Toast
+import androidx.activity.addCallback
+import androidx.activity.compose.setContent
+import androidx.activity.enableEdgeToEdge
+import androidx.activity.result.contract.ActivityResultContracts
+import androidx.activity.viewModels
+import androidx.appcompat.app.AppCompatActivity
+import androidx.core.content.ContextCompat
+import org.kde.kdeconnect.ui.compose.KdeTheme
+import org.kde.kdeconnect_tp.R
+
+/**
+ * Lets the user browse the files of another paired device, and download, upload, rename and delete
+ * them. It talks to the SFTP server the other device runs for its Filesystem access plugin.
+ */
+class RemoteFilesActivity : AppCompatActivity() {
+
+    private val viewModel: RemoteFilesViewModel by viewModels()
+
+    private var pendingDownload: RemoteFile? = null
+
+    private val pickFiles = registerForActivityResult(ActivityResultContracts.GetMultipleContents()) { uris ->
+        if (uris.isNotEmpty()) viewModel.upload(uris)
+    }
+
+    private val requestWritePermission = registerForActivityResult(ActivityResultContracts.RequestPermission()) { granted ->
+        val file = pendingDownload
+        pendingDownload = null
+        if (granted && file != null) {
+            viewModel.download(file)
+        } else if (!granted) {
+            Toast.makeText(this, R.string.files_storage_permission_needed, Toast.LENGTH_LONG).show()
+        }
+    }
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        enableEdgeToEdge()
+
+        val deviceId = intent.getStringExtra(EXTRA_DEVICE_ID)
+        if (deviceId == null) {
+            finish()
+            return
+        }
+        viewModel.start(deviceId)
+
+        onBackPressedDispatcher.addCallback(this) {
+            if (!viewModel.goUp()) finish()
+        }
+
+        setContent {
+            KdeTheme(this) {
+                RemoteFilesScreen(
+                    viewModel = viewModel,
+                    onNavigateUp = { onBackPressedDispatcher.onBackPressed() },
+                    onDownload = ::downloadWithPermission,
+                    onUpload = { pickFiles.launch("*/*") },
+                )
+            }
+        }
+    }
+
+    private fun downloadWithPermission(file: RemoteFile) {
+        // Android 10+ saves downloads through the MediaStore, which needs no permission
+        val needsPermission = Build.VERSION.SDK_INT < Build.VERSION_CODES.Q &&
+            ContextCompat.checkSelfPermission(this, Manifest.permission.WRITE_EXTERNAL_STORAGE) != PackageManager.PERMISSION_GRANTED
+        if (needsPermission) {
+            pendingDownload = file
+            requestWritePermission.launch(Manifest.permission.WRITE_EXTERNAL_STORAGE)
+        } else {
+            viewModel.download(file)
+        }
+    }
+
+    companion object {
+        const val EXTRA_DEVICE_ID = "deviceId"
+    }
+}
