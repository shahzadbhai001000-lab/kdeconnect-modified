@@ -0,0 +1,135 @@
+/*
+ * SPDX-FileCopyrightText: 2026 KDE Connect contributors
+ *
+ * SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+package org.kde.kdeconnect.plugins.sftp
+
+import android.content.ContentResolver
+import android.content.ContentValues
+import android.content.Context
+import android.media.MediaScannerConnection
+import android.net.Uri
+import android.os.Build
+import android.os.Environment
+import android.provider.MediaStore
+import android.webkit.MimeTypeMap
+import androidx.annotation.RequiresApi
+import java.io.File
+import java.io.FileOutputStream
+import java.io.IOException
+import java.io.OutputStream
+
+/**
+ * Where files downloaded from the other phone are saved: Downloads/KDE Connect, keeping the folder
+ * structure when a whole folder is downloaded.
+ *
+ * Android 10+ saves through the MediaStore, which needs no storage permission. Older versions write
+ * the file directly, which needs the storage permission.
+ */
+internal object LocalDownloads {
+
+    const val FOLDER_NAME = "KDE Connect"
+
+    /** An output stream whose file only becomes visible once [close] is called, and is deleted by [abort]. */
+    class Target(
+        private val out: OutputStream,
+        private val onFinish: () -> Unit,
+        private val onAbort: () -> Unit,
+    ) : OutputStream() {
+        private var done = false
+
+        override fun write(b: Int) = out.write(b)
+        override fun write(b: ByteArray, off: Int, len: Int) = out.write(b, off, len)
+        override fun flush() = out.flush()
+
+        override fun close() {
+            if (done) return
+            done = true
+            try {
+                out.close()
+            } finally {
+                onFinish()
+            }
+        }
+
+        /** Discards the partially written file. */
+        fun abort() {
+            if (done) return
+            done = true
+            runCatching { out.close() }
+            onAbort()
+        }
+    }
+
+    /** @param relativeDirectory a folder inside "KDE Connect", or empty for the folder itself. */
+    @Throws(IOException::class)
+    fun create(context: Context, fileName: String, relativeDirectory: String): Target {
+        val subPath = listOf(FOLDER_NAME, relativeDirectory).filter { it.isNotEmpty() }.joinToString("/")
+        return if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q) {
+            createWithMediaStore(context.applicationContext, fileName, subPath)
+        } else {
+            createLegacy(context.applicationContext, fileName, subPath)
+        }
+    }
+
+    @RequiresApi(Build.VERSION_CODES.Q)
+    private fun createWithMediaStore(context: Context, fileName: String, subPath: String): Target {
+        val resolver: ContentResolver = context.contentResolver
+        val values = ContentValues().apply {
+            put(MediaStore.MediaColumns.DISPLAY_NAME, fileName)
+            put(MediaStore.MediaColumns.MIME_TYPE, mimeTypeFor(fileName))
+            put(MediaStore.MediaColumns.RELATIVE_PATH, "${Environment.DIRECTORY_DOWNLOADS}/$subPath")
+            put(MediaStore.MediaColumns.IS_PENDING, 1) // Hidden from other apps until it is complete
+        }
+        val uri: Uri = resolver.insert(MediaStore.Downloads.EXTERNAL_CONTENT_URI, values)
+            ?: throw IOException("Cannot create $fileName in Downloads")
+        val stream = try {
+            resolver.openOutputStream(uri) ?: throw IOException("Cannot write $fileName")
+        } catch (e: Exception) {
+            resolver.delete(uri, null, null)
+            throw if (e is IOException) e else IOException(e.message, e)
+        }
+        return Target(
+            out = stream,
+            onFinish = {
+                val published = ContentValues().apply { put(MediaStore.MediaColumns.IS_PENDING, 0) }
+                resolver.update(uri, published, null, null)
+            },
+            onAbort = { resolver.delete(uri, null, null) },
+        )
+    }
+
+    @Suppress("DEPRECATION") // Direct access to the public Downloads folder is only needed before Android 10
+    private fun createLegacy(context: Context, fileName: String, subPath: String): Target {
+        val directory = File(Environment.getExternalStoragePublicDirectory(Environment.DIRECTORY_DOWNLOADS), subPath)
+        if (!directory.isDirectory && !directory.mkdirs()) throw IOException("Cannot create ${directory.path}")
+
+        val file = uniqueFile(directory, fileName)
+        val stream = FileOutputStream(file)
+        return Target(
+            out = stream,
+            onFinish = { MediaScannerConnection.scanFile(context, arrayOf(file.absolutePath), null, null) },
+            onAbort = { file.delete() },
+        )
+    }
+
+    private fun uniqueFile(directory: File, fileName: String): File {
+        var candidate = File(directory, fileName)
+        if (!candidate.exists()) return candidate
+
+        val base = fileName.substringBeforeLast('.', fileName)
+        val extension = fileName.substringAfterLast('.', "").let { if (it.isEmpty()) "" else ".$it" }
+        var counter = 1
+        while (candidate.exists()) {
+            candidate = File(directory, "$base ($counter)$extension")
+            counter++
+        }
+        return candidate
+    }
+
+    private fun mimeTypeFor(fileName: String): String {
+        val extension = fileName.substringAfterLast('.', "").lowercase()
+        return MimeTypeMap.getSingleton().getMimeTypeFromExtension(extension) ?: "application/octet-stream"
+    }
+}
