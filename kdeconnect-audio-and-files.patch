--- /dev/null
+++ b/src/main/java/org/kde/kdeconnect/plugins/sftp/RemoteSftpClient.kt
@@ -0,0 +1,218 @@
+/*
+ * SPDX-FileCopyrightText: 2026 KDE Connect contributors
+ *
+ * SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+package org.kde.kdeconnect.plugins.sftp
+
+import org.apache.sshd.client.SshClient
+import org.apache.sshd.client.keyverifier.ServerKeyVerifier
+import org.apache.sshd.client.session.ClientSession
+import org.apache.sshd.sftp.client.SftpClient
+import org.apache.sshd.sftp.client.SftpClientFactory
+import java.io.Closeable
+import java.io.IOException
+import java.io.InputStream
+import java.io.OutputStream
+import java.security.PublicKey
+import java.security.interfaces.RSAPublicKey
+
+/** A top-level storage location shared by the other device (eg: "Internal storage"). */
+data class RemoteSftpRoot(val name: String, val path: String)
+
+/** Everything needed to connect to the SFTP server another device just started for us. */
+data class RemoteSftpSession(
+    val host: String,
+    val port: Int,
+    val user: String,
+    val password: String,
+    val roots: List<RemoteSftpRoot>,
+)
+
+data class RemoteFile(
+    val name: String,
+    val path: String,
+    val isDirectory: Boolean,
+    val size: Long,
+    val modifiedMillis: Long,
+)
+
+/**
+ * A client for the SFTP server that the other device exposes through its Filesystem access plugin.
+ *
+ * The connection is only accepted if the server proves it is the paired device: the SSH host key
+ * must match the device's public key, which KDE Connect already pinned when pairing.
+ *
+ * All methods block, so call them from a background thread.
+ */
+class RemoteSftpClient(
+    private val session: RemoteSftpSession,
+    private val trustedHostKey: PublicKey,
+) : Closeable {
+
+    private val lock = Any()
+    private var sshClient: SshClient? = null
+    private var clientSession: ClientSession? = null
+    private var browseClient: SftpClient? = null
+
+    @Throws(IOException::class)
+    fun connect() {
+        SimpleSftpServer.ensureSshdConfigured()
+        val ssh = SshClient.setUpDefaultClient()
+        ssh.serverKeyVerifier = ServerKeyVerifier { _, _, serverKey -> publicKeysMatch(serverKey, trustedHostKey) }
+        ssh.start()
+        sshClient = ssh
+
+        try {
+            val newSession = ssh.connect(session.user, session.host, session.port).verify(CONNECT_TIMEOUT_MS).session
+            clientSession = newSession
+            newSession.addPasswordIdentity(session.password)
+            newSession.auth().verify(AUTH_TIMEOUT_MS)
+            browseClient = SftpClientFactory.instance().createSftpClient(newSession)
+        } catch (e: Exception) {
+            close()
+            throw if (e is IOException) e else IOException(e.message, e)
+        }
+    }
+
+    @Throws(IOException::class)
+    fun list(path: String): List<RemoteFile> = withBrowseClient { sftp ->
+        val result = ArrayList<RemoteFile>()
+        for (entry in sftp.readDir(path)) {
+            val name = entry.filename
+            if (name == "." || name == "..") continue
+            val fullPath = join(path, name)
+
+            var attributes = entry.attributes
+            if (attributes.isSymbolicLink) {
+                // Show what the link points to, not the link itself
+                attributes = runCatching { sftp.stat(fullPath) }.getOrDefault(attributes)
+            }
+            val modified = runCatching { attributes.modifyTime.toMillis() }.getOrDefault(0L)
+            result.add(RemoteFile(name, fullPath, attributes.isDirectory, attributes.size, modified))
+        }
+        result.sortedWith(compareBy<RemoteFile>({ !it.isDirectory }, { it.name.lowercase() }))
+    }
+
+    @Throws(IOException::class)
+    fun createDirectory(path: String) {
+        withBrowseClient { it.mkdir(path) }
+    }
+
+    @Throws(IOException::class)
+    fun rename(oldPath: String, newPath: String) {
+        withBrowseClient { it.rename(oldPath, newPath) }
+    }
+
+    /** Deletes a file, or a folder with everything inside. */
+    @Throws(IOException::class)
+    fun delete(file: RemoteFile) {
+        if (file.isDirectory) {
+            for (child in list(file.path)) delete(child)
+            withBrowseClient { it.rmdir(file.path) }
+        } else {
+            withBrowseClient { it.remove(file.path) }
+        }
+    }
+
+    /** Lists a folder and everything in its subfolders, as (file, path relative to [directory]). */
+    @Throws(IOException::class)
+    fun listRecursive(directory: RemoteFile): List<Pair<RemoteFile, String>> {
+        val result = ArrayList<Pair<RemoteFile, String>>()
+        fun walk(dir: RemoteFile, relative: String) {
+            for (child in list(dir.path)) {
+                if (child.isDirectory) {
+                    walk(child, if (relative.isEmpty()) child.name else "$relative/${child.name}")
+                } else {
+                    result.add(child to relative)
+                }
+            }
+        }
+        walk(directory, "")
+        return result
+    }
+
+    /** Opens a file for reading. It uses its own SFTP channel, so it doesn't block browsing. */
+    @Throws(IOException::class)
+    fun openRead(path: String): InputStream {
+        val sftp = newSftpClient()
+        val stream = try {
+            sftp.read(path)
+        } catch (e: Exception) {
+            sftp.close()
+            throw e
+        }
+        return object : InputStream() {
+            override fun read(): Int = stream.read()
+            override fun read(b: ByteArray, off: Int, len: Int): Int = stream.read(b, off, len)
+            override fun available(): Int = stream.available()
+            override fun close() {
+                try {
+                    stream.close()
+                } finally {
+                    sftp.close()
+                }
+            }
+        }
+    }
+
+    /** Opens a file for writing (creating or overwriting it). Close the stream to finish the upload. */
+    @Throws(IOException::class)
+    fun openWrite(path: String): OutputStream {
+        val sftp = newSftpClient()
+        val stream = try {
+            sftp.write(path)
+        } catch (e: Exception) {
+            sftp.close()
+            throw e
+        }
+        return object : OutputStream() {
+            override fun write(b: Int) = stream.write(b)
+            override fun write(b: ByteArray, off: Int, len: Int) = stream.write(b, off, len)
+            override fun flush() = stream.flush()
+            override fun close() {
+                try {
+                    stream.close()
+                } finally {
+                    sftp.close()
+                }
+            }
+        }
+    }
+
+    override fun close() {
+        synchronized(lock) {
+            runCatching { browseClient?.close() }
+            browseClient = null
+        }
+        runCatching { clientSession?.close(false) }
+        clientSession = null
+        runCatching { sshClient?.stop() }
+        sshClient = null
+    }
+
+    private fun newSftpClient(): SftpClient {
+        val current = clientSession ?: throw IOException("Not connected")
+        return SftpClientFactory.instance().createSftpClient(current)
+    }
+
+    private fun <T> withBrowseClient(block: (SftpClient) -> T): T = synchronized(lock) {
+        val sftp = browseClient ?: throw IOException("Not connected")
+        block(sftp)
+    }
+
+    companion object {
+        private const val CONNECT_TIMEOUT_MS = 15_000L
+        private const val AUTH_TIMEOUT_MS = 15_000L
+
+        fun join(directory: String, name: String): String =
+            if (directory.endsWith("/")) "$directory$name" else "$directory/$name"
+
+        private fun publicKeysMatch(a: PublicKey, b: PublicKey): Boolean {
+            if (a is RSAPublicKey && b is RSAPublicKey) {
+                return a.modulus == b.modulus && a.publicExponent == b.publicExponent
+            }
+            return a == b || a.encoded.contentEquals(b.encoded)
+        }
+    }
+}
diff --git a/src/main/java/org/kde/kdeconnect/plugins/sftp/SftpPlugin.kt b/src/main/java/org/kde/kdeconnect/plugins/sftp/SftpPlugin.kt
