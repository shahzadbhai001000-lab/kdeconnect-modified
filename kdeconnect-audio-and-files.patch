--- /dev/null
+++ b/src/main/java/org/kde/kdeconnect/plugins/sftp/RemoteFilesViewModel.kt
@@ -0,0 +1,269 @@
+/*
+ * SPDX-FileCopyrightText: 2026 KDE Connect contributors
+ *
+ * SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+package org.kde.kdeconnect.plugins.sftp
+
+import android.app.Application
+import android.net.Uri
+import android.provider.OpenableColumns
+import androidx.annotation.StringRes
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.setValue
+import androidx.lifecycle.AndroidViewModel
+import androidx.lifecycle.viewModelScope
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.flow.MutableSharedFlow
+import kotlinx.coroutines.flow.SharedFlow
+import kotlinx.coroutines.flow.asSharedFlow
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withContext
+import org.kde.kdeconnect.KdeConnect
+import org.kde.kdeconnect.helpers.ThreadHelper
+import org.kde.kdeconnect_tp.R
+import java.io.IOException
+
+/**
+ * State and actions of the screen that browses the files of another device
+ * (see [RemoteFilesActivity]), on top of [RemoteSftpClient].
+ */
+class RemoteFilesViewModel(application: Application) : AndroidViewModel(application) {
+
+    enum class Phase { CONNECTING, ERROR, BROWSING }
+
+    var phase by mutableStateOf(Phase.CONNECTING)
+        private set
+    var errorMessage by mutableStateOf<String?>(null)
+        private set
+    var deviceName by mutableStateOf("")
+        private set
+
+    /** The storage locations of the other device (internal storage, SD card...). */
+    var roots by mutableStateOf<List<RemoteSftpRoot>>(emptyList())
+        private set
+
+    /** The folder being shown, or null when the list of [roots] is shown instead. */
+    var currentPath by mutableStateOf<String?>(null)
+        private set
+    var entries by mutableStateOf<List<RemoteFile>>(emptyList())
+        private set
+    var isLoading by mutableStateOf(false)
+        private set
+
+    /** Describes the download/upload/delete in progress, or null when idle. */
+    var busyMessage by mutableStateOf<String?>(null)
+        private set
+
+    private val _messages = MutableSharedFlow<String>(extraBufferCapacity = 8)
+
+    /** One-off messages for the user (results and errors of the operations). */
+    val messages: SharedFlow<String> = _messages.asSharedFlow()
+
+    private var deviceId: String? = null
+    private var client: RemoteSftpClient? = null
+
+    // Folders we came from, so "back" goes up one level. A null entry stands for the list of roots.
+    private val history = ArrayList<String?>()
+
+    private fun string(@StringRes id: Int, vararg args: Any): String = getApplication<Application>().getString(id, *args)
+
+    fun start(deviceId: String) {
+        if (this.deviceId != null) return
+        this.deviceId = deviceId
+        connect()
+    }
+
+    fun connect() {
+        val id = deviceId ?: return
+        phase = Phase.CONNECTING
+        errorMessage = null
+        viewModelScope.launch {
+            try {
+                val device = KdeConnect.getInstance().getDevice(id)
+                    ?: throw IOException(string(R.string.files_connection_timeout))
+                deviceName = device.name
+                val plugin = device.getPlugin(SftpPlugin::class.java)
+                    ?: throw IOException(string(R.string.files_connection_timeout))
+
+                val session = plugin.requestRemoteSession()
+                val newClient = withContext(Dispatchers.IO) {
+                    RemoteSftpClient(session, device.certificate.publicKey).also { it.connect() }
+                }
+                closeClientInBackground()
+                client = newClient
+
+                roots = session.roots
+                history.clear()
+                currentPath = null
+                entries = emptyList()
+                phase = Phase.BROWSING
+                if (roots.size == 1) load(roots[0].path)
+            } catch (e: CancellationException) {
+                throw e
+            } catch (e: Exception) {
+                errorMessage = string(R.string.files_connection_failed, e.message ?: e.toString())
+                phase = Phase.ERROR
+            }
+        }
+    }
+
+    fun openFolder(path: String) {
+        history.add(currentPath)
+        load(path)
+    }
+
+    /** Goes up one level. Returns false if we are already at the top, so the screen should close. */
+    fun goUp(): Boolean {
+        if (phase != Phase.BROWSING || history.isEmpty()) return false
+        val previous = history.removeAt(history.lastIndex)
+        if (previous == null) {
+            currentPath = null
+            entries = emptyList()
+        } else {
+            load(previous)
+        }
+        return true
+    }
+
+    fun refresh() {
+        currentPath?.let { load(it) }
+    }
+
+    private fun load(path: String) {
+        val activeClient = client ?: return
+        currentPath = path
+        isLoading = true
+        viewModelScope.launch {
+            try {
+                val listing = withContext(Dispatchers.IO) { activeClient.list(path) }
+                if (currentPath == path) entries = listing
+            } catch (e: CancellationException) {
+                throw e
+            } catch (e: Exception) {
+                if (currentPath == path) entries = emptyList()
+                _messages.tryEmit(string(R.string.files_operation_failed, e.message ?: e.toString()))
+            } finally {
+                isLoading = false
+            }
+        }
+    }
+
+    fun download(file: RemoteFile) {
+        launchOperation(string(R.string.files_downloading, file.name), refreshAfterwards = false) { activeClient ->
+            if (file.isDirectory) {
+                for ((child, relativeDirectory) in activeClient.listRecursive(file)) {
+                    saveFile(activeClient, child, listOf(file.name, relativeDirectory).filter { it.isNotEmpty() }.joinToString("/"))
+                }
+            } else {
+                saveFile(activeClient, file, "")
+            }
+            string(R.string.files_downloaded, file.name)
+        }
+    }
+
+    private fun saveFile(activeClient: RemoteSftpClient, file: RemoteFile, relativeDirectory: String) {
+        val target = LocalDownloads.create(getApplication(), file.name, relativeDirectory)
+        try {
+            activeClient.openRead(file.path).use { input -> input.copyTo(target, COPY_BUFFER_SIZE) }
+            target.close()
+        } catch (e: Exception) {
+            target.abort()
+            throw e
+        }
+    }
+
+    fun upload(uris: List<Uri>) {
+        val directory = currentPath ?: return
+        val names = uris.map { displayName(it) }
+        val label = if (uris.size == 1) names[0] else uris.size.toString()
+        launchOperation(string(R.string.files_uploading, label), refreshAfterwards = true) { activeClient ->
+            val resolver = getApplication<Application>().contentResolver
+            uris.forEachIndexed { index, uri ->
+                val input = resolver.openInputStream(uri) ?: throw IOException(names[index])
+                input.use { source ->
+                    activeClient.openWrite(RemoteSftpClient.join(directory, names[index])).use { destination ->
+                        source.copyTo(destination, COPY_BUFFER_SIZE)
+                    }
+                }
+            }
+            string(R.string.files_uploaded, label)
+        }
+    }
+
+    fun rename(file: RemoteFile, newName: String) {
+        val name = newName.trim().replace('/', '_')
+        if (name.isEmpty() || name == file.name) return
+        val parent = file.path.substringBeforeLast('/', "").ifEmpty { "/" }
+        launchOperation(string(R.string.files_rename), refreshAfterwards = true) { activeClient ->
+            activeClient.rename(file.path, RemoteSftpClient.join(parent, name))
+            null
+        }
+    }
+
+    fun delete(file: RemoteFile) {
+        launchOperation(string(R.string.files_delete), refreshAfterwards = true) { activeClient ->
+            activeClient.delete(file)
+            null
+        }
+    }
+
+    fun createFolder(name: String) {
+        val directory = currentPath ?: return
+        val folderName = name.trim().replace('/', '_')
+        if (folderName.isEmpty()) return
+        launchOperation(string(R.string.files_new_folder), refreshAfterwards = true) { activeClient ->
+            activeClient.createDirectory(RemoteSftpClient.join(directory, folderName))
+            null
+        }
+    }
+
+    /** Runs [block] off the main thread while showing [busy], then reports its result (if any) to the user. */
+    private fun launchOperation(
+        busy: String,
+        refreshAfterwards: Boolean,
+        block: (RemoteSftpClient) -> String?,
+    ) {
+        val activeClient = client ?: return
+        viewModelScope.launch {
+            busyMessage = busy
+            try {
+                withContext(Dispatchers.IO) { block(activeClient) }?.let { _messages.tryEmit(it) }
+            } catch (e: CancellationException) {
+                throw e
+            } catch (e: Exception) {
+                _messages.tryEmit(string(R.string.files_operation_failed, e.message ?: e.toString()))
+            } finally {
+                busyMessage = null
+            }
+            if (refreshAfterwards) refresh()
+        }
+    }
+
+    private fun displayName(uri: Uri): String {
+        val resolver = getApplication<Application>().contentResolver
+        val fromProvider = runCatching {
+            resolver.query(uri, arrayOf(OpenableColumns.DISPLAY_NAME), null, null, null)?.use { cursor ->
+                if (cursor.moveToFirst()) cursor.getString(0) else null
+            }
+        }.getOrNull()
+        val name = fromProvider ?: uri.lastPathSegment?.substringAfterLast('/') ?: "file"
+        return name.replace('/', '_')
+    }
+
+    private fun closeClientInBackground() {
+        val old = client ?: return
+        client = null
+        ThreadHelper.runOnNewThread { old.close() }
+    }
+
+    override fun onCleared() {
+        closeClientInBackground()
+    }
+
+    private companion object {
+        const val COPY_BUFFER_SIZE = 64 * 1024
+    }
+}
