+/*
+ * SPDX-FileCopyrightText: 2026 KDE Connect contributors
+ *
+ * SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+package org.kde.kdeconnect.plugins.screenshare
+
+import android.annotation.SuppressLint
+import android.app.AlertDialog
+import android.content.Context
+import android.graphics.Color
+import android.graphics.Typeface
+import android.os.Bundle
+import android.os.Handler
+import android.os.Looper
+import android.util.TypedValue
+import android.view.Gravity
+import android.view.SurfaceHolder
+import android.view.SurfaceView
+import android.view.View
+import android.view.ViewConfiguration
+import android.view.ViewGroup
+import android.view.WindowManager
+import android.widget.Button
+import android.widget.FrameLayout
+import android.widget.LinearLayout
+import android.widget.TextView
+import android.widget.Toast
+import androidx.activity.ComponentActivity
+import androidx.core.view.WindowCompat
+import androidx.core.view.WindowInsetsCompat
+import androidx.core.view.WindowInsetsControllerCompat
+import org.kde.kdeconnect.KdeConnect
+import org.kde.kdeconnect.NetworkPacket
+import org.kde.kdeconnect_tp.R
+
+/**
+ * Shows the screen of another phone, full screen, with a small hideable readout of the speed.
+ *
+ * The session is not ended when the app goes to the background: the stream keeps running and the
+ * picture comes back when this screen returns.
+ */
+class ScreenViewerActivity : ComponentActivity() {
+
+    private lateinit var deviceId: String
+    private lateinit var settings: ScreenShareSettings
+    private lateinit var surfaceView: AspectSurfaceView
+    private lateinit var statsView: TextView
+    private lateinit var statusView: TextView
+    private lateinit var controlButton: Button
+    private lateinit var touchSender: TouchGestureSender
+
+    private val handler = Handler(Looper.getMainLooper())
+    private var decoder: ScreenStreamDecoder? = null
+    private var surface: android.view.Surface? = null
+    private var streamHeader: StreamHeader? = null
+
+    private var lastBytes = 0L
+    private var lastFrames = 0L
+    private var lastTickMillis = 0L
+
+    private val statsTick = object : Runnable {
+        override fun run() {
+            updateStats()
+            plugin()?.sendPing()
+            handler.postDelayed(this, STATS_INTERVAL_MS)
+        }
+    }
+
+    private fun plugin(): ScreenSharePlugin? =
+        KdeConnect.getInstance().getDevice(deviceId)?.getPlugin(ScreenSharePlugin::class.java)
+
+    private fun deviceName(): String = KdeConnect.getInstance().getDevice(deviceId)?.name.orEmpty()
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+
+        val id = intent.getStringExtra(EXTRA_DEVICE_ID)
+        if (id == null) {
+            finish()
+            return
+        }
+        deviceId = id
+        settings = ScreenShareSettings(this)
+
+        window.addFlags(WindowManager.LayoutParams.FLAG_KEEP_SCREEN_ON)
+        WindowCompat.setDecorFitsSystemWindows(window, false)
+        WindowCompat.getInsetsController(window, window.decorView).apply {
+            hide(WindowInsetsCompat.Type.systemBars())
+            systemBarsBehavior = WindowInsetsControllerCompat.BEHAVIOR_SHOW_TRANSIENT_BARS_BY_SWIPE
+        }
+
+        setContentView(buildLayout())
+
+        ScreenShareState.viewerListener = { header, payload ->
+            runOnUiThread { onStream(header, payload) }
+        }
+        ScreenShareState.takePending()?.let { (header, payload) -> onStream(header, payload) }
+
+        if (savedInstanceState == null && intent.getBooleanExtra(EXTRA_AUTO_REQUEST, false)) {
+            requestStart()
+        }
+    }
+
+    override fun onStart() {
+        super.onStart()
+        lastTickMillis = System.currentTimeMillis()
+        handler.post(statsTick)
+    }
+
+    override fun onStop() {
+        handler.removeCallbacks(statsTick)
+        super.onStop()
+    }
+
+    override fun onDestroy() {
+        handler.removeCallbacks(statsTick)
+        ScreenShareState.viewerListener = null
+        touchSender.reset()
+        decoder?.stop()
+        decoder = null
+        if (isFinishing) plugin()?.requestStop()
+        super.onDestroy()
+    }
+
+    // -- Layout -------------------------------------------------------------------------------
+
+    private fun dp(value: Int): Int =
+        TypedValue.applyDimension(TypedValue.COMPLEX_UNIT_DIP, value.toFloat(), resources.displayMetrics).toInt()
+
+    private fun buildLayout(): View {
+        val root = FrameLayout(this).apply { setBackgroundColor(Color.BLACK) }
+
+        surfaceView = AspectSurfaceView(this)
+        surfaceView.holder.addCallback(object : SurfaceHolder.Callback {
+            override fun surfaceCreated(holder: SurfaceHolder) {
+                surface = holder.surface
+                decoder?.attachSurface(holder.surface)
+            }
+
+            override fun surfaceChanged(holder: SurfaceHolder, format: Int, width: Int, height: Int) {}
+
+            override fun surfaceDestroyed(holder: SurfaceHolder) {
+                decoder?.detachSurface()
+                surface = null
+            }
+        })
+        root.addView(
+            surfaceView,
+            FrameLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT, Gravity.CENTER)
+        )
+        setupTouch()
+
+        statusView = TextView(this).apply {
+            setTextColor(Color.WHITE)
+            gravity = Gravity.CENTER
+            setPadding(dp(32), 0, dp(32), 0)
+            text = getString(R.string.screenshare_waiting, deviceName())
+        }
+        root.addView(
+            statusView,
+            FrameLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT, Gravity.CENTER)
+        )
+
+        statsView = TextView(this).apply {
+            setTextColor(Color.WHITE)
+            setTextSize(TypedValue.COMPLEX_UNIT_SP, 11f)
+            typeface = Typeface.MONOSPACE
+            setBackgroundColor(0x99000000.toInt())
+            setPadding(dp(6), dp(3), dp(6), dp(3))
+            visibility = if (settings.showStats) View.VISIBLE else View.GONE
+        }
+        root.addView(
+            statsView,
+            FrameLayout.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT, Gravity.TOP or Gravity.START)
+                .apply { setMargins(dp(8), dp(8), 0, 0) }
+        )
+
+        val bar = LinearLayout(this).apply {
+            orientation = LinearLayout.HORIZONTAL
+            alpha = 0.75f
+        }
+        bar.addView(barButton(R.string.screenshare_button_settings) { showSettingsMenu() })
+        bar.addView(barButton(R.string.screenshare_button_stats) { toggleStats() })
+        controlButton = barButton(controlLabel()) { toggleControl() }
+        bar.addView(controlButton)
+        bar.addView(barButton(R.string.screenshare_button_stop) { stopAndClose() })
+        root.addView(
+            bar,
+            FrameLayout.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT, Gravity.TOP or Gravity.END)
+                .apply { setMargins(0, dp(4), dp(4), 0) }
+        )
+
+        val nav = LinearLayout(this).apply {
+            orientation = LinearLayout.HORIZONTAL
+            alpha = 0.75f
+        }
+        nav.addView(barButton(R.string.screenshare_nav_back) { plugin()?.sendGlobalAction("back") })
+        nav.addView(barButton(R.string.screenshare_nav_home) { plugin()?.sendGlobalAction("home") })
+        nav.addView(barButton(R.string.screenshare_nav_recents) { plugin()?.sendGlobalAction("recents") })
+        root.addView(
+            nav,
+            FrameLayout.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT, Gravity.BOTTOM or Gravity.CENTER_HORIZONTAL)
+                .apply { setMargins(0, 0, 0, dp(8)) }
+        )
+
+        return root
+    }
+
+    private fun barButton(textRes: Int, onClick: () -> Unit): Button = Button(this).apply {
+        setText(textRes)
+        setTextSize(TypedValue.COMPLEX_UNIT_SP, 12f)
+        isAllCaps = false
+        minHeight = 0
+        minimumHeight = 0
+        minWidth = 0
+        minimumWidth = 0
+        setPadding(dp(10), dp(4), dp(10), dp(4))
+        setOnClickListener { onClick() }
+    }
+
+    // -- Stream -------------------------------------------------------------------------------
+
+    private fun onStream(header: StreamHeader, payload: NetworkPacket.Payload) {
+        decoder?.stop()
+        streamHeader = header
+        surfaceView.setVideoSize(header.width, header.height)
+        statusView.visibility = View.GONE
+
+        lastBytes = 0L
+        lastFrames = 0L
+        lastTickMillis = System.currentTimeMillis()
+
+        val newDecoder = ScreenStreamDecoder(
+            header,
+            payload,
+            onKeyframeNeeded = { plugin()?.requestKeyframe() },
+            onEnded = { ended -> runOnUiThread { onStreamEnded(ended) } },
+        )
+        decoder = newDecoder
+        newDecoder.start()
+        surface?.let { newDecoder.attachSurface(it) }
+    }
+
+    private fun onStreamEnded(ended: ScreenStreamDecoder) {
+        if (decoder !== ended) return // An older stream ending after a newer one started
+        decoder = null
+        statusView.text = getString(R.string.screenshare_ended)
+        statusView.visibility = View.VISIBLE
+    }
+
+    private fun requestStart() {
+        plugin()?.requestStart(settings.preset, settings.autoStopMinutes, settings.soundEnabled)
+        statusView.text = getString(R.string.screenshare_waiting, deviceName())
+    }
+
+    private fun stopAndClose() {
+        plugin()?.requestStop()
+        finish()
+    }
+
+    // -- Touch control ------------------------------------------------------------------------
+
+    private fun controlLabel(): Int =
+        if (settings.controlEnabled) R.string.screenshare_control_on else R.string.screenshare_control_off
+
+    private fun toggleControl() {
+        settings.controlEnabled = !settings.controlEnabled
+        touchSender.reset()
+        controlButton.setText(controlLabel())
+    }
+
+    /** Hands every touch on the picture to [touchSender], which decides how to send it. */
+    @SuppressLint("ClickableViewAccessibility")
+    private fun setupTouch() {
+        touchSender = TouchGestureSender(
+            plugin = { plugin() },
+            slopPx = ViewConfiguration.get(this).scaledTouchSlop.toFloat()
+        )
+        surfaceView.setOnTouchListener { view, event ->
+            if (!settings.controlEnabled || decoder == null) return@setOnTouchListener false
+            touchSender.onTouch(view, event)
+            true
+        }
+    }
+
+    // -- Speed readout ------------------------------------------------------------------------
+
+    private fun toggleStats() {
+        settings.showStats = !settings.showStats
+        statsView.visibility = if (settings.showStats) View.VISIBLE else View.GONE
+    }
+
+    @SuppressLint("SetTextI18n")
+    private fun updateStats() {
+        val current = decoder
+        val header = streamHeader
+        if (current == null || header == null) {
+            statsView.text = ""
+            return
+        }
+        val now = System.currentTimeMillis()
+        val seconds = maxOf(0.001, (now - lastTickMillis) / 1000.0)
+        val bytes = current.bytesReceived.get()
+        val frames = current.framesDrawn.get()
+        val bitsPerSecond = (bytes - lastBytes) * 8 / seconds
+        val fps = (frames - lastFrames) / seconds
+        lastBytes = bytes
+        lastFrames = frames
+        lastTickMillis = now
+
+        val speed = if (bitsPerSecond >= 1_000_000) {
+            "%.1f Mbps".format(bitsPerSecond / 1_000_000)
+        } else {
+            "%.0f kbps".format(bitsPerSecond / 1000)
+        }
+        val ping = ScreenShareState.lastRttMs.let { if (it >= 0) "$it ms" else "-- ms" }
+        statsView.text = "$speed | %.0f fps | $ping | ${header.width}x${header.height}".format(fps) +
+            "\nsent: ${touchSender.lastSent} | phone: ${ScreenShareState.lastGestureResult}"
+    }
+
+    // -- Settings -----------------------------------------------------------------------------
+
+    private fun showSettingsMenu() {
+        val items = arrayOf(
+            getString(R.string.screenshare_menu_preset, getString(settings.preset.labelRes)),
+            getString(R.string.screenshare_menu_limit, limitLabel(settings.autoStopMinutes)),
+            getString(if (settings.soundEnabled) R.string.screenshare_menu_sound_on else R.string.screenshare_menu_sound_off),
+        )
+        AlertDialog.Builder(this)
+            .setItems(items) { _, which ->
+                when (which) {
+                    0 -> showPresetDialog()
+                    1 -> showLimitDialog()
+                    else -> {
+                        settings.soundEnabled = !settings.soundEnabled
+                        Toast.makeText(this, R.string.screenshare_sound_applied, Toast.LENGTH_LONG).show()
+                    }
+                }
+            }
+            .show()
+    }
+
+    private fun showPresetDialog() {
+        val presets = ScreenPreset.entries
+        val labels = presets.map { getString(it.labelRes) }.toTypedArray()
+        AlertDialog.Builder(this)
+            .setTitle(R.string.screenshare_preset_title)
+            .setSingleChoiceItems(labels, presets.indexOf(settings.preset)) { dialog, which ->
+                val chosen = presets[which]
+                settings.preset = chosen
+                // The bitrate changes right away. Size and frame rate apply when sharing starts again.
+                plugin()?.sendBitrate(chosen.bitrate)
+                Toast.makeText(this, R.string.screenshare_preset_applied, Toast.LENGTH_LONG).show()
+                dialog.dismiss()
+            }
+            .show()
+    }
+
+    private fun showLimitDialog() {
+        val choices = ScreenShareSettings.AUTO_STOP_CHOICES
+        val labels = choices.map { limitLabel(it) }.toTypedArray()
+        AlertDialog.Builder(this)
+            .setTitle(R.string.screenshare_limit_title)
+            .setSingleChoiceItems(labels, choices.indexOf(settings.autoStopMinutes)) { dialog, which ->
+                settings.autoStopMinutes = choices[which]
+                Toast.makeText(this, R.string.screenshare_limit_applied, Toast.LENGTH_LONG).show()
+                dialog.dismiss()
+            }
+            .show()
+    }
+
+    private fun limitLabel(minutes: Int): String =
+        if (minutes == 0) getString(R.string.screenshare_limit_unlimited) else getString(R.string.screenshare_limit_minutes, minutes)
+
+    // -- Video view ---------------------------------------------------------------------------
+
+    /** A [SurfaceView] that keeps the proportions of the video and is centered in its parent. */
+    private class AspectSurfaceView(context: Context) : SurfaceView(context) {
+        private var videoWidth = 0
+        private var videoHeight = 0
+
+        fun setVideoSize(width: Int, height: Int) {
+            videoWidth = width
+            videoHeight = height
+            requestLayout()
+        }
+
+        override fun onMeasure(widthMeasureSpec: Int, heightMeasureSpec: Int) {
+            val maxWidth = MeasureSpec.getSize(widthMeasureSpec)
+            val maxHeight = MeasureSpec.getSize(heightMeasureSpec)
+            if (videoWidth == 0 || videoHeight == 0) {
+                setMeasuredDimension(maxWidth, maxHeight)
+                return
+            }
+            val scale = minOf(maxWidth.toFloat() / videoWidth, maxHeight.toFloat() / videoHeight)
+            setMeasuredDimension((videoWidth * scale).toInt(), (videoHeight * scale).toInt())
+        }
+    }
+
+    companion object {
+        const val EXTRA_DEVICE_ID = "deviceId"
+        const val EXTRA_AUTO_REQUEST = "autoRequest"
+        private const val STATS_INTERVAL_MS = 1000L
+
+    }
+}
diff --git a/src/main/java/org/kde/kdeconnect/plugins/screenshare/TouchGestureSender.kt b/src/main/java/org/kde/kdeconnect/plugins/screenshare/TouchGestureSender.kt
new file mode 100644
index 00000000..0f007c46
--- /dev/null
+++ b/src/main/java/org/kde/kdeconnect/plugins/screenshare/TouchGestureSender.kt
@@ -0,0 +1,219 @@
+/*
+ * SPDX-FileCopyrightText: 2026 KDE Connect contributors
+ *
+ * SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+package org.kde.kdeconnect.plugins.screenshare
+
+import android.os.Handler
+import android.os.Looper
+import android.view.MotionEvent
+import android.view.View
+import java.util.Locale
+import kotlin.math.hypot
+
+/**
+ * Turns the touches on the viewer into commands for the other phone.
+ *
+ * Android on the other phone can't follow a finger in real time, so we first work out what the
+ * touch is, and then send it in the way that works best:
+ *
+ * - a short touch that doesn't move is sent as one **tap**, so it can never become a long press;
+ * - a quick swipe is sent as one finished **swipe** with its real speed, so flicks scroll properly;
+ * - a finger that stays down, a slow drag, or two or more fingers are sent **live**.
+ *
+ * Positions are always a fraction of the picture (0 to 1), so they are right on any screen size.
+ * Must be used from the main thread.
+ */
+internal class TouchGestureSender(
+    private val plugin: () -> ScreenSharePlugin?,
+    private val slopPx: Float,
+) {
+    private enum class State { IDLE, PENDING, SWIPING, LIVE }
+
+    private var state = State.IDLE
+    private val handler = Handler(Looper.getMainLooper())
+
+    private var width = 1f
+    private var height = 1f
+
+    // Where the first finger went down
+    private var startX = 0f
+    private var startY = 0f
+    private var startPxX = 0f
+    private var startPxY = 0f
+    private var startTime = 0L
+    private var firstPointerId = -1
+
+    private var lastMoveSentAt = 0L
+
+    /** What was last sent to the other phone, shown in the speed readout to help find problems. */
+    @Volatile
+    var lastSent: String = "-"
+        private set
+    private val swipePoints = ArrayList<Pair<Float, Float>>()
+
+    // Every finger currently down: id to (x, y), both between 0 and 1
+    private val current = LinkedHashMap<Int, Pair<Float, Float>>()
+
+    /** The finger stayed still, or the drag went on, for too long to be a tap or a flick. */
+    private val goLiveRunnable = Runnable { goLive() }
+
+    fun onTouch(view: View, event: MotionEvent) {
+        if (view.width == 0 || view.height == 0) return
+        width = view.width.toFloat()
+        height = view.height.toFloat()
+        updateCurrent(event)
+
+        when (event.actionMasked) {
+            MotionEvent.ACTION_DOWN -> onDown(event)
+            MotionEvent.ACTION_POINTER_DOWN -> onPointerDown(event)
+            MotionEvent.ACTION_MOVE -> onMove(event)
+            MotionEvent.ACTION_POINTER_UP -> onPointerUp(event)
+            MotionEvent.ACTION_UP -> onUp(event)
+            MotionEvent.ACTION_CANCEL -> onCancel()
+        }
+    }
+
+    /** Forgets the touch in progress, for example when the viewer is closed. */
+    fun reset() {
+        handler.removeCallbacks(goLiveRunnable)
+        state = State.IDLE
+        swipePoints.clear()
+        current.clear()
+    }
+
+    private fun onDown(event: MotionEvent) {
+        reset()
+        updateCurrent(event) // reset() forgot the finger that onTouch() had just recorded
+        firstPointerId = event.getPointerId(0)
+        startX = (event.getX(0) / width).coerceIn(0f, 1f)
+        startY = (event.getY(0) / height).coerceIn(0f, 1f)
+        startPxX = event.getX(0)
+        startPxY = event.getY(0)
+        startTime = event.eventTime
+        swipePoints.add(startX to startY)
+        state = State.PENDING
+        handler.postDelayed(goLiveRunnable, HOLD_MS)
+    }
+
+    private fun onPointerDown(event: MotionEvent) {
+        val id = event.getPointerId(event.actionIndex)
+        if (state == State.PENDING || state == State.SWIPING) {
+            // A second finger: this is not a tap or a swipe. The first finger is sent from where it started.
+            handler.removeCallbacks(goLiveRunnable)
+            state = State.LIVE
+            sendDown(firstPointerId, startX, startY)
+        }
+        if (state == State.LIVE) sendDown(id, null, null)
+    }
+
+    private fun onMove(event: MotionEvent) {
+        when (state) {
+            State.PENDING -> {
+                val index = event.findPointerIndex(firstPointerId)
+                if (index < 0) return
+                if (hypot(event.getX(index) - startPxX, event.getY(index) - startPxY) > slopPx) {
+                    // It moved: a swipe, unless it takes too long
+                    handler.removeCallbacks(goLiveRunnable)
+                    state = State.SWIPING
+                    val left = (SWIPE_LIVE_MS - (event.eventTime - startTime)).coerceAtLeast(0L)
+                    handler.postDelayed(goLiveRunnable, left)
+                    addSwipePoint()
+                }
+            }
+            State.SWIPING -> addSwipePoint()
+            State.LIVE -> {
+                // Touch screens report far more often than the other phone can replay
+                if (event.eventTime - lastMoveSentAt >= MOVE_INTERVAL_MS) {
+                    lastMoveSentAt = event.eventTime
+                    plugin()?.sendTouch("move", -1, pointsText(), null, null)
+                }
+            }
+            State.IDLE -> {}
+        }
+    }
+
+    private fun onPointerUp(event: MotionEvent) {
+        val id = event.getPointerId(event.actionIndex)
+        if (state == State.LIVE) plugin()?.sendTouch("up", id, pointsText(), null, null)
+        current.remove(id)
+    }
+
+    private fun onUp(event: MotionEvent) {
+        handler.removeCallbacks(goLiveRunnable)
+        val id = event.getPointerId(event.actionIndex)
+        when (state) {
+            State.PENDING -> {
+                lastSent = "tap"
+                plugin()?.sendTap(startX, startY)
+            }
+            State.SWIPING -> {
+                addSwipePoint()
+                val duration = (event.eventTime - startTime).coerceIn(MIN_SWIPE_MS, MAX_SWIPE_MS)
+                lastSent = "swipe ${swipePoints.size}pts ${duration}ms"
+                plugin()?.sendSwipe(swipeText(), duration.toInt())
+            }
+            State.LIVE -> plugin()?.sendTouch("up", id, pointsText(), null, null)
+            State.IDLE -> {}
+        }
+        reset()
+    }
+
+    private fun onCancel() {
+        handler.removeCallbacks(goLiveRunnable)
+        if (state == State.LIVE) plugin()?.sendTouch("cancel", -1, pointsText(), null, null)
+        reset()
+    }
+
+    private fun goLive() {
+        if (state != State.PENDING && state != State.SWIPING) return
+        state = State.LIVE
+        lastSent = "hold"
+        sendDown(firstPointerId, startX, startY)
+    }
+
+    private fun sendDown(id: Int, fromX: Float?, fromY: Float?) {
+        plugin()?.sendTouch("down", id, pointsText(), fromX, fromY)
+    }
+
+    private fun updateCurrent(event: MotionEvent) {
+        for (i in 0 until event.pointerCount) {
+            current[event.getPointerId(i)] =
+                (event.getX(i) / width).coerceIn(0f, 1f) to (event.getY(i) / height).coerceIn(0f, 1f)
+        }
+    }
+
+    private fun addSwipePoint() {
+        val point = current[firstPointerId] ?: return
+        if (swipePoints.size < MAX_SWIPE_POINTS) {
+            swipePoints.add(point)
+        } else {
+            swipePoints[swipePoints.size - 1] = point
+        }
+    }
+
+    private fun pointsText(): String =
+        current.entries.joinToString(";") { (id, point) -> format(id, point.first, point.second) }
+
+    private fun swipeText(): String =
+        swipePoints.joinToString(";") { String.format(Locale.US, "%.4f,%.4f", it.first, it.second) }
+
+    private fun format(id: Int, x: Float, y: Float): String = String.format(Locale.US, "%d,%.4f,%.4f", id, x, y)
+
+    private companion object {
+        /**
+         * A touch released before this is a click. One that is still down is a press: it starts
+         * on the other phone, which turns it into a long press about half a second later.
+         */
+        const val HOLD_MS = 500L
+
+        /** A moving finger is followed live after this long (a swipe of any length, like a graphic tablet); a quicker flick is sent whole. */
+        const val SWIPE_LIVE_MS = 150L
+
+        const val MOVE_INTERVAL_MS = 25L
+        const val MIN_SWIPE_MS = 40L
+        const val MAX_SWIPE_MS = 1500L
+        const val MAX_SWIPE_POINTS = 60
+    }
+}
diff --git a/src/main/java/org/kde/kdeconnect/plugins/screenshare/VideoPipeInputStream.kt b/src/main/java/org/kde/kdeconnect/plugins/screenshare/VideoPipeInputStream.kt
