+import org.kde.kdeconnect_tp.R
+import java.text.DateFormat
+import java.util.Date
+
+@Composable
+internal fun RemoteFilesScreen(
+    viewModel: RemoteFilesViewModel,
+    onNavigateUp: () -> Unit,
+    onDownload: (RemoteFile) -> Unit,
+    onUpload: () -> Unit,
+) {
+    val snackbarHostState = remember { SnackbarHostState() }
+    LaunchedEffect(viewModel) {
+        viewModel.messages.collect { snackbarHostState.showSnackbar(it) }
+    }
+
+    var renameTarget by remember { mutableStateOf<RemoteFile?>(null) }
+    var deleteTarget by remember { mutableStateOf<RemoteFile?>(null) }
+    var showNewFolderDialog by rememberSaveable { mutableStateOf(false) }
+
+    val isBrowsing = viewModel.phase == RemoteFilesViewModel.Phase.BROWSING
+    val insideFolder = isBrowsing && viewModel.currentPath != null
+
+    Scaffold(
+        topBar = {
+            KdeTopAppBar(
+                title = stringResource(R.string.files_title, viewModel.deviceName),
+                subTitle = viewModel.currentPath,
+                navIconDescription = stringResource(androidx.appcompat.R.string.abc_action_bar_up_description),
+                navIconOnClick = onNavigateUp,
+                actions = {
+                    if (isBrowsing) {
+                        if (insideFolder) {
+                            IconButton(onClick = { showNewFolderDialog = true }) {
+                                Icon(painterResource(R.drawable.ic_folder), stringResource(R.string.files_new_folder))
+                            }
+                        }
+                        IconButton(onClick = { if (insideFolder) viewModel.refresh() else viewModel.connect() }) {
+                            Icon(Icons.Default.Refresh, stringResource(R.string.refresh))
+                        }
+                    }
+                }
+            )
+        },
+        floatingActionButton = {
+            if (insideFolder) {
+                FloatingActionButton(onClick = onUpload) {
+                    Icon(Icons.Default.Add, stringResource(R.string.files_upload))
+                }
+            }
+        },
+        snackbarHost = { SnackbarHost(snackbarHostState) }
+    ) { innerPadding ->
+        Column(Modifier.fillMaxSize().padding(innerPadding)) {
+            val busy = viewModel.busyMessage
+            if (viewModel.isLoading || busy != null) {
+                LinearProgressIndicator(Modifier.fillMaxWidth())
+            }
+            if (busy != null) {
+                Text(
+                    busy,
+                    style = MaterialTheme.typography.bodySmall,
+                    maxLines = 1,
+                    overflow = TextOverflow.Ellipsis,
+                    modifier = Modifier.padding(horizontal = 16.dp, vertical = 4.dp)
+                )
+            }
+
+            when (viewModel.phase) {
+                RemoteFilesViewModel.Phase.CONNECTING -> CenteredMessage {
+                    CircularProgressIndicator()
+                    Text(stringResource(R.string.files_connecting), modifier = Modifier.padding(top = 16.dp))
+                }
+
+                RemoteFilesViewModel.Phase.ERROR -> CenteredMessage {
+                    Text(viewModel.errorMessage.orEmpty(), textAlign = TextAlign.Center)
+                    Button(onClick = viewModel::connect, modifier = Modifier.padding(top = 16.dp)) {
+                        Text(stringResource(R.string.files_retry))
+                    }
+                }
+
+                RemoteFilesViewModel.Phase.BROWSING -> {
+                    if (viewModel.currentPath == null) {
+                        RootsList(viewModel.roots, onOpen = viewModel::openFolder)
+                    } else {
+                        FileList(
+                            entries = viewModel.entries,
+                            isLoading = viewModel.isLoading,
+                            onOpenFolder = { viewModel.openFolder(it.path) },
+                            onDownload = onDownload,
+                            onRename = { renameTarget = it },
+                            onDelete = { deleteTarget = it },
+                        )
+                    }
+                }
+            }
+        }
+    }
+
+    if (showNewFolderDialog) {
+        NameDialog(
+            title = stringResource(R.string.files_new_folder),
+            initialName = "",
+            onConfirm = {
+                showNewFolderDialog = false
+                viewModel.createFolder(it)
+            },
+            onDismiss = { showNewFolderDialog = false }
+        )
+    }
+
+    renameTarget?.let { file ->
+        NameDialog(
+            title = stringResource(R.string.files_rename),
+            initialName = file.name,
+            onConfirm = {
+                renameTarget = null
+                viewModel.rename(file, it)
+            },
+            onDismiss = { renameTarget = null }
+        )
+    }
+
+    deleteTarget?.let { file ->
+        AlertDialog(
+            onDismissRequest = { deleteTarget = null },
+            title = { Text(stringResource(R.string.files_delete)) },
+            text = { Text(stringResource(R.string.files_delete_confirm, file.name)) },
+            confirmButton = {
+                TextButton(onClick = {
+                    deleteTarget = null
+                    viewModel.delete(file)
+                }) { Text(stringResource(R.string.files_delete)) }
+            },
+            dismissButton = {
+                TextButton(onClick = { deleteTarget = null }) { Text(stringResource(R.string.cancel)) }
+            }
+        )
+    }
+}
+
+@Composable
+private fun CenteredMessage(content: @Composable () -> Unit) {
+    Box(Modifier.fillMaxSize().padding(24.dp), contentAlignment = Alignment.Center) {
+        Column(horizontalAlignment = Alignment.CenterHorizontally) { content() }
+    }
+}
+
+@Composable
+private fun RootsList(roots: List<RemoteSftpRoot>, onOpen: (String) -> Unit) {
+    LazyColumn(Modifier.fillMaxSize()) {
+        items(roots, key = { it.path }) { root ->
+            FileRow(
+                isDirectory = true,
+                name = root.name,
+                details = root.path,
+                onClick = { onOpen(root.path) },
+                menu = null,
+            )
+            HorizontalDivider()
+        }
+    }
+}
+
+@Composable
+private fun FileList(
+    entries: List<RemoteFile>,
+    isLoading: Boolean,
+    onOpenFolder: (RemoteFile) -> Unit,
+    onDownload: (RemoteFile) -> Unit,
+    onRename: (RemoteFile) -> Unit,
+    onDelete: (RemoteFile) -> Unit,
+) {
+    if (entries.isEmpty() && !isLoading) {
+        CenteredMessage { Text(stringResource(R.string.files_empty)) }
+        return
+    }
+
+    val context = LocalContext.current
+    val dateFormat = remember { DateFormat.getDateTimeInstance(DateFormat.SHORT, DateFormat.SHORT) }
+
+    LazyColumn(Modifier.fillMaxSize()) {
+        items(entries, key = { it.path }) { file ->
+            val details = buildList {
+                if (!file.isDirectory) add(Formatter.formatShortFileSize(context, file.size))
+                if (file.modifiedMillis > 0) add(dateFormat.format(Date(file.modifiedMillis)))
+            }.joinToString(" · ")
+
+            FileRow(
+                isDirectory = file.isDirectory,
+                name = file.name,
+                details = details,
+                onClick = { if (file.isDirectory) onOpenFolder(file) else onDownload(file) },
+                menu = { dismiss ->
+                    DropdownMenuItem(
+                        text = { Text(stringResource(R.string.files_download)) },
+                        onClick = { dismiss(); onDownload(file) }
+                    )
+                    DropdownMenuItem(
+                        text = { Text(stringResource(R.string.files_rename)) },
+                        onClick = { dismiss(); onRename(file) }
+                    )
+                    DropdownMenuItem(
+                        text = { Text(stringResource(R.string.files_delete)) },
+                        onClick = { dismiss(); onDelete(file) }
+                    )
+                }
+            )
+            HorizontalDivider()
+        }
+    }
+}
+
+@Composable
+private fun FileRow(
+    isDirectory: Boolean,
+    name: String,
+    details: String,
+    onClick: () -> Unit,
+    menu: (@Composable (dismiss: () -> Unit) -> Unit)?,
+) {
+    Row(
+        modifier = Modifier
+            .fillMaxWidth()
+            .clickable(onClick = onClick)
+            .padding(start = 16.dp, top = 8.dp, bottom = 8.dp, end = if (menu == null) 16.dp else 4.dp),
+        verticalAlignment = Alignment.CenterVertically,
+        horizontalArrangement = Arrangement.spacedBy(16.dp)
+    ) {
+        Icon(
+            painter = painterResource(if (isDirectory) R.drawable.ic_folder else R.drawable.ic_file),
+            contentDescription = null,
+            tint = if (isDirectory) MaterialTheme.colorScheme.primary else MaterialTheme.colorScheme.onSurfaceVariant
+        )
+        Column(Modifier.weight(1f)) {
+            Text(name, style = MaterialTheme.typography.bodyLarge, maxLines = 2, overflow = TextOverflow.Ellipsis)
+            if (details.isNotEmpty()) {
+                Text(
+                    details,
+                    style = MaterialTheme.typography.bodySmall,
+                    color = MaterialTheme.colorScheme.onSurfaceVariant,
+                    maxLines = 1,
+                    overflow = TextOverflow.Ellipsis
+                )
+            }
+        }
+        if (menu != null) {
+            var expanded by remember { mutableStateOf(false) }
+            Box {
+                IconButton(onClick = { expanded = true }) {
+                    Icon(Icons.Default.MoreVert, contentDescription = null)
+                }
+                DropdownMenu(expanded = expanded, onDismissRequest = { expanded = false }) {
+                    menu { expanded = false }
+                }
+            }
+        }
+    }
+}
+
+@Composable
+private fun NameDialog(
+    title: String,
+    initialName: String,
+    onConfirm: (String) -> Unit,
+    onDismiss: () -> Unit,
+) {
+    var name by rememberSaveable { mutableStateOf(initialName) }
+    AlertDialog(
+        onDismissRequest = onDismiss,
+        title = { Text(title) },
+        text = {
+            OutlinedTextField(
+                value = name,
+                onValueChange = { name = it },
+                label = { Text(stringResource(R.string.files_name)) },
+                singleLine = true,
+                modifier = Modifier.fillMaxWidth()
+            )
+        },
+        confirmButton = {
+            TextButton(onClick = { onConfirm(name) }, enabled = name.isNotBlank()) {
+                Text(stringResource(R.string.ok))
+            }
+        },
+        dismissButton = {
+            TextButton(onClick = onDismiss) { Text(stringResource(R.string.cancel)) }
+        }
+    )
+}
