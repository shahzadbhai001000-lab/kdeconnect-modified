+/*
+ * SPDX-FileCopyrightText: 2026 KDE Connect contributors
+ *
+ * SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+package org.kde.kdeconnect.plugins.audiostream
+
+import org.junit.Assert.assertArrayEquals
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.util.concurrent.atomic.AtomicInteger
+
+class PcmPipeInputStreamTest {
+
+    // The first read throws away whatever was captured before the consumer connected, so tests
+    // consume it with a tiny priming chunk first.
+    private fun primed(): PcmPipeInputStream {
+        val pipe = PcmPipeInputStream {}
+        val primer = Thread { pipe.read(ByteArray(1), 0, 1) }
+        primer.start()
+        Thread.sleep(100)
+        pipe.push(byteArrayOf(0))
+        primer.join(2000)
+        return pipe
+    }
+
+    @Test
+    fun readsPushedChunksInOrder() {
+        val pipe = primed()
+        pipe.push(byteArrayOf(1, 2, 3))
+        pipe.push(byteArrayOf(4, 5))
+
+        val buffer = ByteArray(8)
+        assertEquals(3, pipe.read(buffer, 0, 8))
+        assertArrayEquals(byteArrayOf(1, 2, 3), buffer.copyOf(3))
+        assertEquals(2, pipe.read(buffer, 0, 8))
+        assertArrayEquals(byteArrayOf(4, 5), buffer.copyOf(2))
+    }
+
+    @Test
+    fun largeChunkIsSplitAcrossReads() {
+        val pipe = primed()
+        pipe.push(byteArrayOf(1, 2, 3))
+
+        val buffer = ByteArray(2)
+        assertEquals(2, pipe.read(buffer, 0, 2))
+        assertArrayEquals(byteArrayOf(1, 2), buffer)
+        assertEquals(1, pipe.read(buffer, 0, 2))
+        assertEquals(3, buffer[0].toInt())
+    }
+
+    @Test
+    fun finishEndsTheStream() {
+        val pipe = PcmPipeInputStream {}
+        pipe.finish()
+        assertEquals(-1, pipe.read(ByteArray(4), 0, 4))
+        assertEquals(-1, pipe.read(ByteArray(4), 0, 4))
+    }
+
+    @Test
+    fun closeNotifiesOwnerAndEndsTheStream() {
+        val closed = AtomicInteger()
+        val pipe = PcmPipeInputStream { closed.incrementAndGet() }
+        pipe.close()
+        assertEquals(1, closed.get())
+        assertEquals(-1, pipe.read(ByteArray(4), 0, 4))
+    }
+
+    @Test
+    fun pushNeverBlocksWhenNobodyReads() {
+        val pipe = PcmPipeInputStream {}
+        val start = System.nanoTime()
+        repeat(10_000) { pipe.push(ByteArray(960)) }
+        assertTrue("push must not block", (System.nanoTime() - start) / 1_000_000 < 2000)
+    }
+}
