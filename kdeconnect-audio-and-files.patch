@@ -0,0 +1,239 @@
+/*
+ * SPDX-FileCopyrightText: 2026 KDE Connect contributors
+ *
+ * SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+package org.kde.kdeconnect.plugins.audiostream
+
+import android.Manifest
+import android.app.Notification
+import android.app.PendingIntent
+import android.app.Service
+import android.content.Intent
+import android.content.pm.PackageManager
+import android.content.pm.ServiceInfo
+import android.media.AudioAttributes
+import android.media.AudioFormat
+import android.media.AudioPlaybackCaptureConfiguration
+import android.media.AudioRecord
+import android.media.projection.MediaProjection
+import android.media.projection.MediaProjectionManager
+import android.os.Build
+import android.os.Handler
+import android.os.IBinder
+import android.os.Looper
+import android.os.Process
+import android.util.Log
+import androidx.annotation.RequiresApi
+import androidx.core.app.NotificationCompat
+import androidx.core.app.ServiceCompat
+import androidx.core.content.ContextCompat
+import androidx.core.content.IntentCompat
+import androidx.core.content.getSystemService
+import org.kde.kdeconnect.Device
+import org.kde.kdeconnect.KdeConnect
+import org.kde.kdeconnect.NetworkPacket
+import org.kde.kdeconnect.helpers.NotificationHelper
+import org.kde.kdeconnect_tp.R
+
+/**
+ * Captures everything this phone plays (music, videos, games...) and streams it to another device
+ * as raw PCM through the payload of a [AudioStreamPlugin.PACKET_TYPE_AUDIOSTREAM] packet.
+ *
+ * Uses Android's AudioPlaybackCapture, which needs Android 10 (API 29) and the user's consent
+ * through the screen capture dialog (see [AudioCaptureConsentActivity]). Apps can opt out of being
+ * captured, so some of them (e.g. DRM-protected streaming apps) will stay silent.
+ */
+@RequiresApi(Build.VERSION_CODES.Q)
+class AudioCaptureService : Service() {
+
+    private val lock = Any()
+    private var projection: MediaProjection? = null
+    private var record: AudioRecord? = null
+    private var pipe: PcmPipeInputStream? = null
+
+    @Volatile
+    private var running = false
+
+    override fun onBind(intent: Intent?): IBinder? = null
+
+    override fun onStartCommand(intent: Intent?, flags: Int, startId: Int): Int {
+        if (intent == null || intent.action == ACTION_STOP) {
+            stopStreaming()
+            return START_NOT_STICKY
+        }
+
+        // A service started with startForegroundService() must call startForeground() promptly,
+        // and on Android 14+ it has to happen before the MediaProjection is created.
+        val device = intent.getStringExtra(EXTRA_DEVICE_ID)?.let { KdeConnect.getInstance().getDevice(it) }
+        ServiceCompat.startForeground(
+            this,
+            NOTIFICATION_ID,
+            buildNotification(device?.name.orEmpty()),
+            ServiceInfo.FOREGROUND_SERVICE_TYPE_MEDIA_PROJECTION
+        )
+
+        val resultCode = intent.getIntExtra(EXTRA_RESULT_CODE, 0)
+        val resultData = IntentCompat.getParcelableExtra(intent, EXTRA_RESULT_DATA, Intent::class.java)
+        val hasPermission = ContextCompat.checkSelfPermission(this, Manifest.permission.RECORD_AUDIO) ==
+            PackageManager.PERMISSION_GRANTED
+
+        if (device == null || resultData == null || !hasPermission || !device.isReachable) {
+            Log.w(LOG_TAG, "Not starting: device=$device, data=$resultData, permission=$hasPermission")
+            stopStreaming()
+            return START_NOT_STICKY
+        }
+
+        stopStreaming(stopService = false) // Replace any previous stream
+        try {
+            startStreaming(device, resultCode, resultData)
+        } catch (e: Exception) {
+            Log.e(LOG_TAG, "Could not start capturing audio", e)
+            stopStreaming()
+        }
+        return START_NOT_STICKY
+    }
+
+    override fun onDestroy() {
+        stopStreaming(stopService = false)
+        super.onDestroy()
+    }
+
+    private fun startStreaming(device: Device, resultCode: Int, resultData: Intent) {
+        val projectionManager = getSystemService<MediaProjectionManager>()!!
+        val newProjection = projectionManager.getMediaProjection(resultCode, resultData)
+            ?: throw IllegalStateException("Screen capture was not granted")
+
+        // Required on Android 14+, and tells us when the user stops the capture from the system UI
+        newProjection.registerCallback(object : MediaProjection.Callback() {
+            override fun onStop() {
+                stopStreaming()
+            }
+        }, Handler(Looper.getMainLooper()))
+
+        val captureConfig = AudioPlaybackCaptureConfiguration.Builder(newProjection)
+            .addMatchingUsage(AudioAttributes.USAGE_MEDIA)
+            .addMatchingUsage(AudioAttributes.USAGE_GAME)
+            .addMatchingUsage(AudioAttributes.USAGE_UNKNOWN)
+            .build()
+
+        val format = AudioFormat.Builder()
+            .setEncoding(AudioFormat.ENCODING_PCM_16BIT)
+            .setSampleRate(SAMPLE_RATE)
+            .setChannelMask(AudioFormat.CHANNEL_IN_STEREO)
+            .build()
+
+        val minBuffer = AudioRecord.getMinBufferSize(SAMPLE_RATE, AudioFormat.CHANNEL_IN_STEREO, AudioFormat.ENCODING_PCM_16BIT)
+        val newRecord = AudioRecord.Builder()
+            .setAudioFormat(format)
+            .setBufferSizeInBytes(maxOf(minBuffer, CHUNK_BYTES * 4))
+            .setAudioPlaybackCaptureConfig(captureConfig)
+            .build()
+        if (newRecord.state != AudioRecord.STATE_INITIALIZED) {
+            newRecord.release()
+            newProjection.stop()
+            throw IllegalStateException("Could not initialize the audio capture")
+        }
+
+        val newPipe = PcmPipeInputStream(onClosed = { stopStreaming() })
+
+        synchronized(lock) {
+            projection = newProjection
+            record = newRecord
+            pipe = newPipe
+            running = true
+        }
+        AudioShareState.started(device.deviceId) { stopStreaming() }
+
+        val packet = NetworkPacket(AudioStreamPlugin.PACKET_TYPE_AUDIOSTREAM).apply {
+            this["sampleRate"] = SAMPLE_RATE
+            this["channels"] = CHANNELS
+            this["encoding"] = AudioStreamPlugin.ENCODING_PCM_S16LE
+            // The size of a live stream is unknown, and the payload ends when the stream closes
+            payload = NetworkPacket.Payload(newPipe, -1L)
+        }
+        device.sendPacket(packet, object : Device.SendPacketStatusCallback() {
+            override fun onSuccess() {}
+
+            override fun onFailure(e: Throwable) {
+                Log.e(LOG_TAG, "Could not send the audio stream to ${device.name}", e)
+                stopStreaming()
+            }
+        })
+
+        newRecord.startRecording()
+        Thread({ captureLoop(newRecord, newPipe) }, "AudioCapture").start()
+    }
+
+    private fun captureLoop(source: AudioRecord, destination: PcmPipeInputStream) {
+        Process.setThreadPriority(Process.THREAD_PRIORITY_URGENT_AUDIO)
+        val buffer = ByteArray(CHUNK_BYTES)
+        while (running) {
+            val read = source.read(buffer, 0, buffer.size)
+            if (read < 0) break // The capture was stopped or failed
+            if (read > 0) destination.push(buffer.copyOf(read))
+        }
+        if (running) stopStreaming() // Ended by itself, not because we were asked to stop
+    }
+
+    private fun stopStreaming(stopService: Boolean = true) {
+        var recordToRelease: AudioRecord? = null
+        var projectionToStop: MediaProjection? = null
+        var pipeToFinish: PcmPipeInputStream? = null
+        synchronized(lock) {
+            running = false
+            recordToRelease = record
+            projectionToStop = projection
+            pipeToFinish = pipe
+            record = null
+            projection = null
+            pipe = null
+        }
+        AudioShareState.ended()
+
+        pipeToFinish?.finish()
+        recordToRelease?.let {
+            runCatching { it.stop() }
+            it.release()
+        }
+        projectionToStop?.let { runCatching { it.stop() } }
+
+        if (stopService) {
+            ServiceCompat.stopForeground(this, ServiceCompat.STOP_FOREGROUND_REMOVE)
+            stopSelf()
+        }
+    }
+
+    private fun buildNotification(deviceName: String): Notification {
+        val stopIntent = PendingIntent.getService(
+            this,
+            0,
+            Intent(this, AudioCaptureService::class.java).setAction(ACTION_STOP),
+            PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE
+        )
+        return NotificationCompat.Builder(this, NotificationHelper.Channels.MEDIA_CONTROL)
+            .setSmallIcon(R.drawable.ic_notification)
+            .setContentTitle(getString(R.string.audiostream_notification_title, deviceName))
+            .setOngoing(true)
+            .setOnlyAlertOnce(true)
+            .addAction(R.drawable.ic_stop, getString(R.string.audiostream_notification_stop), stopIntent)
+            .build()
+    }
+
+    companion object {
+        const val EXTRA_DEVICE_ID = "deviceId"
+        const val EXTRA_RESULT_CODE = "resultCode"
+        const val EXTRA_RESULT_DATA = "resultData"
+        const val ACTION_STOP = "org.kde.kdeconnect.plugins.audiostream.STOP"
+
+        private const val LOG_TAG = "AudioCaptureService"
+        private const val NOTIFICATION_ID = 0x41554431
+
+        const val SAMPLE_RATE = 48000
+        const val CHANNELS = 2
+        private const val BYTES_PER_FRAME = CHANNELS * 2
+
+        // 20 ms of audio per chunk
+        private const val CHUNK_BYTES = SAMPLE_RATE / 50 * BYTES_PER_FRAME
+    }
+}
