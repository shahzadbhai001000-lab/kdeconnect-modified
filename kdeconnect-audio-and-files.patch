@@ -0,0 +1,84 @@
+/*
+ * SPDX-FileCopyrightText: 2026 KDE Connect contributors
+ *
+ * SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+package org.kde.kdeconnect.plugins.screenshare
+
+import android.content.Context
+import org.kde.kdeconnect_tp.R
+
+/**
+ * How the shared screen is encoded. Smaller pictures and fewer frames mean less delay.
+ *
+ * @param maxSide the longest side of the video, in pixels
+ * @param fps frames per second
+ * @param bitrate video bits per second
+ */
+internal enum class ScreenPreset(val maxSide: Int, val fps: Int, val bitrate: Int, val labelRes: Int) {
+    FASTEST(960, 30, 1_500_000, R.string.screenshare_preset_fastest),
+    BALANCED(1280, 30, 3_000_000, R.string.screenshare_preset_balanced),
+    QUALITY(1920, 30, 8_000_000, R.string.screenshare_preset_quality),
+
+    /** Tiny picture for when only Bluetooth is available. */
+    BLUETOOTH(480, 8, 150_000, R.string.screenshare_preset_bluetooth);
+
+    companion object {
+        val DEFAULT = BALANCED
+
+        fun fromName(name: String?): ScreenPreset =
+            entries.firstOrNull { it.name == name } ?: DEFAULT
+    }
+}
+
+/** Remembered choices of the user, shared by the viewer screen and by the sharing side. */
+internal class ScreenShareSettings(context: Context) {
+
+    private val prefs = context.applicationContext.getSharedPreferences(PREFS_NAME, Context.MODE_PRIVATE)
+
+    var preset: ScreenPreset
+        get() = ScreenPreset.fromName(prefs.getString(KEY_PRESET, null))
+        set(value) {
+            prefs.edit().putString(KEY_PRESET, value.name).apply()
+        }
+
+    /** Whether the small speed/fps/delay numbers are shown on the viewer. */
+    var showStats: Boolean
+        get() = prefs.getBoolean(KEY_SHOW_STATS, true)
+        set(value) {
+            prefs.edit().putBoolean(KEY_SHOW_STATS, value).apply()
+        }
+
+    /** Whether the sound of the shared phone is sent along with its screen. */
+    var soundEnabled: Boolean
+        get() = prefs.getBoolean(KEY_SOUND, true)
+        set(value) {
+            prefs.edit().putBoolean(KEY_SOUND, value).apply()
+        }
+
+    /** Whether touches on the viewer are sent to the other phone (otherwise it is view only). */
+    var controlEnabled: Boolean
+        get() = prefs.getBoolean(KEY_CONTROL, true)
+        set(value) {
+            prefs.edit().putBoolean(KEY_CONTROL, value).apply()
+        }
+
+    /** Stops the session by itself after this many minutes. 0 means unlimited. */
+    var autoStopMinutes: Int
+        get() = prefs.getInt(KEY_AUTO_STOP, 0)
+        set(value) {
+            prefs.edit().putInt(KEY_AUTO_STOP, value).apply()
+        }
+
+    companion object {
+        private const val PREFS_NAME = "screenshare"
+        private const val KEY_PRESET = "preset"
+        private const val KEY_SHOW_STATS = "show_stats"
+        private const val KEY_AUTO_STOP = "auto_stop_minutes"
+        private const val KEY_CONTROL = "control_enabled"
+        private const val KEY_SOUND = "sound_enabled"
+
+        /** The choices offered for the session limit, in minutes (0 = unlimited). */
+        val AUTO_STOP_CHOICES = intArrayOf(0, 15, 30, 60, 120)
+    }
+}
