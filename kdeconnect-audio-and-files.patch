@@ -0,0 +1,106 @@
+/*
+ * SPDX-FileCopyrightText: 2026 KDE Connect contributors
+ *
+ * SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+package org.kde.kdeconnect.plugins.audiostream
+
+import android.media.AudioFormat
+import android.media.AudioManager
+import android.media.AudioTrack
+import android.os.Process
+import android.util.Log
+import org.kde.kdeconnect.NetworkPacket
+import java.io.IOException
+
+/**
+ * Plays the raw 16-bit PCM audio that arrives through a [NetworkPacket.Payload] until the
+ * other phone stops sending, [stop] is called or the connection drops.
+ *
+ * Works on every Android version supported by the app (only capturing audio needs Android 10).
+ */
+internal class AudioStreamPlayer(
+    private val sampleRate: Int,
+    private val channels: Int,
+    private val payload: NetworkPacket.Payload,
+    private val onFinished: (AudioStreamPlayer) -> Unit,
+) {
+    @Volatile
+    private var stopped = false
+
+    private var thread: Thread? = null
+
+    fun start() {
+        thread = Thread({ playLoop() }, "AudioStreamPlayer").also { it.start() }
+    }
+
+    /** Safe to call from any thread, and more than once. */
+    fun stop() {
+        stopped = true
+        // Closing the payload closes its socket, which unblocks a read() in progress
+        payload.close()
+    }
+
+    @Suppress("DEPRECATION") // The AudioTrack constructor is the only one available on API < 26
+    private fun playLoop() {
+        Process.setThreadPriority(Process.THREAD_PRIORITY_URGENT_AUDIO)
+
+        var track: AudioTrack? = null
+        try {
+            val input = payload.inputStream ?: throw IOException("Audio stream has no data")
+
+            val channelMask = if (channels == 1) AudioFormat.CHANNEL_OUT_MONO else AudioFormat.CHANNEL_OUT_STEREO
+            val frameSize = channels * BYTES_PER_SAMPLE
+            val minBuffer = AudioTrack.getMinBufferSize(sampleRate, channelMask, AudioFormat.ENCODING_PCM_16BIT)
+            if (minBuffer <= 0) throw IOException("Unsupported audio format: $sampleRate Hz, $channels channels")
+
+            // ~200 ms of audio absorbs Wi-Fi jitter without adding a noticeable delay
+            val bufferSize = maxOf(minBuffer, sampleRate * frameSize / 5)
+            track = AudioTrack(
+                AudioManager.STREAM_MUSIC,
+                sampleRate,
+                channelMask,
+                AudioFormat.ENCODING_PCM_16BIT,
+                bufferSize,
+                AudioTrack.MODE_STREAM
+            )
+            if (track.state != AudioTrack.STATE_INITIALIZED) throw IOException("Could not initialize the audio output")
+            track.play()
+
+            val buffer = ByteArray(READ_BUFFER_BYTES - READ_BUFFER_BYTES % frameSize)
+            var filled = 0
+            while (!stopped) {
+                val read = input.read(buffer, filled, buffer.size - filled)
+                if (read < 0) break
+                filled += read
+
+                // AudioTrack needs whole frames, keep any partial frame for the next round
+                val usable = filled - filled % frameSize
+                var offset = 0
+                while (offset < usable && !stopped) {
+                    val written = track.write(buffer, offset, usable - offset)
+                    if (written <= 0) throw IOException("Audio output failed ($written)")
+                    offset += written
+                }
+                val remainder = filled - usable
+                if (remainder > 0) System.arraycopy(buffer, usable, buffer, 0, remainder)
+                filled = remainder
+            }
+        } catch (e: Exception) {
+            if (!stopped) Log.w(LOG_TAG, "Audio playback ended with an error", e)
+        } finally {
+            track?.let {
+                runCatching { it.stop() }
+                it.release()
+            }
+            payload.close()
+            onFinished(this)
+        }
+    }
+
+    private companion object {
+        const val LOG_TAG = "AudioStreamPlayer"
+        const val BYTES_PER_SAMPLE = 2
+        const val READ_BUFFER_BYTES = 16 * 1024
+    }
+}
