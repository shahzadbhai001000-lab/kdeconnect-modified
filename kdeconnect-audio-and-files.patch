+/*
+ * SPDX-FileCopyrightText: 2026 KDE Connect contributors
+ *
+ * SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+package org.kde.kdeconnect.plugins.audiostream
+
+/**
+ * Tracks which device this phone is currently sending its audio to.
+ *
+ * Kept apart from [AudioCaptureService] (which uses Android 10+ APIs) so the plugin can query
+ * and stop a share on older Android versions without touching that class.
+ */
+internal object AudioShareState {
+
+    @Volatile
+    var activeDeviceId: String? = null
+        private set
+
+    @Volatile
+    private var stopAction: (() -> Unit)? = null
+
+    fun started(deviceId: String, stop: () -> Unit) {
+        activeDeviceId = deviceId
+        stopAction = stop
+    }
+
+    fun ended() {
+        activeDeviceId = null
+        stopAction = null
+    }
+
+    fun isSharingWith(deviceId: String): Boolean = activeDeviceId == deviceId
+
+    /** Stops the share, but only if it is going to [deviceId]. */
+    fun stopIfSharingWith(deviceId: String) {
+        if (activeDeviceId == deviceId) stopAction?.invoke()
+    }
+}
