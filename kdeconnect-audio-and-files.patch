index 0000000..f8ad89e
--- /dev/null
+++ b/src/main/java/org/kde/kdeconnect/plugins/audiostream/PcmPipeInputStream.kt
@@ -0,0 +1,99 @@
+/*
+ * SPDX-FileCopyrightText: 2026 KDE Connect contributors
+ *
+ * SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+package org.kde.kdeconnect.plugins.audiostream
+
+import java.io.InputStream
+import java.util.concurrent.LinkedBlockingQueue
+import java.util.concurrent.atomic.AtomicBoolean
+
+/**
+ * An [InputStream] fed in real time by the audio capture thread and drained by the payload
+ * sender (see LanLink.sendPayload).
+ *
+ * The queue is bounded: when the network can't keep up, the oldest audio is dropped so the
+ * stream never falls further and further behind what is playing on the sending phone.
+ *
+ * [onClosed] is called when the consumer closes the stream (the other phone stopped listening,
+ * the connection dropped or it never connected), so the capture can be stopped.
+ */
+internal class PcmPipeInputStream(private val onClosed: () -> Unit) : InputStream() {
+
+    private val queue = LinkedBlockingQueue<ByteArray>(MAX_QUEUED_CHUNKS)
+    private val finished = AtomicBoolean(false)
+
+    // Only touched by the single consumer thread
+    private var current: ByteArray = EMPTY
+    private var position = 0
+    private var reachedEnd = false
+    private var firstRead = true
+
+    /** Called by the capture thread. Never blocks. */
+    fun push(chunk: ByteArray) {
+        if (finished.get()) return
+        while (!queue.offer(chunk)) {
+            queue.poll() // Drop the oldest chunk to make room
+            if (finished.get()) return
+        }
+    }
+
+    /** Ends the stream. The consumer sees end-of-stream as soon as it asks for more data. */
+    fun finish() {
+        if (finished.compareAndSet(false, true)) {
+            queue.clear()
+            queue.offer(END_OF_STREAM)
+        }
+    }
+
+    override fun read(): Int {
+        val single = ByteArray(1)
+        return if (read(single, 0, 1) < 0) -1 else single[0].toInt() and 0xFF
+    }
+
+    override fun read(buffer: ByteArray, offset: Int, length: Int): Int {
+        if (length == 0) return 0
+        if (reachedEnd) return -1
+
+        if (firstRead) {
+            // The consumer starts reading once the other phone has connected. Anything captured
+            // before that is stale, so skip it to keep the latency as low as possible.
+            firstRead = false
+            queue.clear()
+        }
+
+        if (position >= current.size) {
+            val next = try {
+                queue.take()
+            } catch (e: InterruptedException) {
+                Thread.currentThread().interrupt()
+                reachedEnd = true
+                return -1
+            }
+            if (next === END_OF_STREAM) {
+                reachedEnd = true
+                return -1
+            }
+            current = next
+            position = 0
+        }
+
+        val count = minOf(length, current.size - position)
+        System.arraycopy(current, position, buffer, offset, count)
+        position += count
+        return count
+    }
+
+    override fun close() {
+        finish()
+        onClosed()
+    }
+
+    private companion object {
+        // 50 chunks of 20 ms = at most one second of buffered audio
+        const val MAX_QUEUED_CHUNKS = 50
+        val EMPTY = ByteArray(0)
+        val END_OF_STREAM = ByteArray(0)
+    }
+}
diff --git a/src/main/java/org/kde/kdeconnect/plugins/sftp/LocalDownloads.kt b/src/main/java/org/kde/kdeconnect/plugins/sftp/LocalDownloads.kt
