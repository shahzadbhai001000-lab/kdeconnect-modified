+
+    /**
+     * Asks the other device to start its SFTP server and waits for the credentials it sends back.
+     *
+     * @throws IOException if the other device reports an error or doesn't answer in time.
+     */
+    @Throws(IOException::class)
+    suspend fun requestRemoteSession(): RemoteSftpSession {
+        val deferred = CompletableDeferred<RemoteSftpSession>()
+        pendingRemoteSession = deferred
+        try {
+            device.sendPacket(NetworkPacket(PACKET_TYPE_SFTP_REQUEST).apply { this["startBrowsing"] = true })
+            return withTimeoutOrNull(REMOTE_SESSION_TIMEOUT_MS) { deferred.await() }
+                ?: throw IOException(context.getString(R.string.files_connection_timeout))
+        } finally {
+            if (pendingRemoteSession === deferred) pendingRemoteSession = null
+        }
+    }
+
+    private fun handleRemoteSessionPacket(np: NetworkPacket): Boolean {
+        val pending = pendingRemoteSession ?: return false
+
+        np.getStringOrNull("errorMessage")?.let { message ->
+            pending.completeExceptionally(IOException(message))
+            return true
+        }
+
+        val host = np.getStringOrNull("ip")
+        val port = np.getInt("port", -1)
+        val password = np.getStringOrNull("password")
+        // Other packets of this type (eg: "serverRunning" notifications) carry no credentials
+        if (host == null || port <= 0 || password == null) return false
+
+        val paths = np.getStringList("multiPaths") ?: listOf(np.getString("path", "/"))
+        val names = np.getStringList("pathNames")
+        val roots = paths.mapIndexed { index, path -> RemoteSftpRoot(names?.getOrNull(index) ?: path, path) }
+        pending.complete(RemoteSftpSession(host, port, np.getString("user", SimpleSftpServer.USER), password, roots))
+        return true
+    }
