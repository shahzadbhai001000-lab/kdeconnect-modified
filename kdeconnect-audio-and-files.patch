+ *
+ * SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+package org.kde.kdeconnect.plugins.screenshare
+
+import android.app.Notification
+import android.app.PendingIntent
+import android.app.Service
+import android.content.Intent
+import android.Manifest
+import android.content.pm.PackageManager
+import android.content.pm.ServiceInfo
+import android.hardware.display.DisplayManager
+import android.hardware.display.VirtualDisplay
+import android.media.AudioAttributes
+import android.media.AudioFormat
+import android.media.AudioPlaybackCaptureConfiguration
+import android.media.AudioRecord
+import android.media.MediaCodec
+import android.media.MediaCodecInfo
+import android.media.MediaFormat
+import android.media.projection.MediaProjection
+import android.media.projection.MediaProjectionManager
+import android.net.wifi.WifiManager
+import android.os.Build
+import android.os.Bundle
+import android.os.Handler
+import android.os.IBinder
+import android.os.Looper
+import android.os.PowerManager
+import android.os.Process
+import android.util.DisplayMetrics
+import android.util.Log
+import android.view.Surface
+import android.view.WindowManager
+import androidx.annotation.RequiresApi
+import androidx.core.app.NotificationCompat
+import androidx.core.app.ServiceCompat
+import androidx.core.content.ContextCompat
+import androidx.core.content.IntentCompat
+import androidx.core.content.getSystemService
+import org.kde.kdeconnect.Device
+import org.kde.kdeconnect.KdeConnect
+import org.kde.kdeconnect.NetworkPacket
+import org.kde.kdeconnect.helpers.NotificationHelper
+import org.kde.kdeconnect.plugins.audiostream.AudioStreamPlugin
+import org.kde.kdeconnect.plugins.audiostream.PcmPipeInputStream
+import org.kde.kdeconnect_tp.R
+
+/**
+ * Captures this phone's screen, encodes it as H.264 and streams it to another device through the
+ * payload of a [ScreenSharePlugin.PACKET_TYPE_SCREENSHARE] packet.
+ *
+ * It runs as a foreground service holding a CPU lock and a Wi-Fi lock, so the session keeps going
+ * when the screen turns off, and it has no time limit unless the user chose one.
+ */
+class ScreenCaptureService : Service() {
+
+    private val lock = Any()
+    private val handler = Handler(Looper.getMainLooper())
+
+    private var projection: MediaProjection? = null
+    private var display: VirtualDisplay? = null
+    private var inputSurface: Surface? = null
+    private var pipe: VideoPipeInputStream? = null
+    private var wakeLock: PowerManager.WakeLock? = null
+    private var wifiLock: WifiManager.WifiLock? = null
+    private var autoStop: Runnable? = null
+    private var audioRecord: AudioRecord? = null
+    private var audioPipe: PcmPipeInputStream? = null
+
+    @Volatile
+    private var audioRunning = false
+
+    @Volatile
+    private var encoder: MediaCodec? = null
+
+    @Volatile
+    private var running = false
+
+    override fun onBind(intent: Intent?): IBinder? = null
+
+    override fun onStartCommand(intent: Intent?, flags: Int, startId: Int): Int {
+        if (intent == null || intent.action == ACTION_STOP) {
+            stopStreaming()
+            return START_NOT_STICKY
+        }
+
+        // A service started with startForegroundService() must call startForeground() promptly,
+        // and on Android 14+ it has to happen before the MediaProjection is created.
+        val device = intent.getStringExtra(EXTRA_DEVICE_ID)?.let { KdeConnect.getInstance().getDevice(it) }
+        ServiceCompat.startForeground(
+            this,
+            NOTIFICATION_ID,
+            buildNotification(device?.name.orEmpty()),
+            ServiceInfo.FOREGROUND_SERVICE_TYPE_MEDIA_PROJECTION
+        )
+
+        val resultCode = intent.getIntExtra(EXTRA_RESULT_CODE, 0)
+        val resultData = IntentCompat.getParcelableExtra(intent, EXTRA_RESULT_DATA, Intent::class.java)
+        val preset = ScreenPreset.fromName(intent.getStringExtra(EXTRA_PRESET))
+        val autoStopMinutes = intent.getIntExtra(EXTRA_AUTO_STOP_MINUTES, 0)
+        val withSound = intent.getBooleanExtra(EXTRA_SOUND, false)
+
+        if (device == null || resultData == null || !device.isReachable) {
+            Log.w(LOG_TAG, "Not starting: device=$device, data=$resultData")
+            stopStreaming()
+            return START_NOT_STICKY
+        }
+
+        stopStreaming(stopService = false) // Replace any previous stream
+        try {
+            startStreaming(device, resultCode, resultData, preset, autoStopMinutes, withSound)
+        } catch (e: Exception) {
+            Log.e(LOG_TAG, "Could not start sharing the screen", e)
+            stopStreaming()
+        }
+        return START_NOT_STICKY
+    }
+
+    override fun onDestroy() {
+        stopStreaming(stopService = false)
+        super.onDestroy()
+    }
+
+    @Suppress("DEPRECATION") // Display.getRealMetrics is the only way to get the full size on API < 30
+    private fun startStreaming(
+        device: Device,
+        resultCode: Int,
+        resultData: Intent,
+        preset: ScreenPreset,
+        autoStopMinutes: Int,
+        withSound: Boolean,
+    ) {
+        val projectionManager = getSystemService<MediaProjectionManager>()!!
+        val newProjection = projectionManager.getMediaProjection(resultCode, resultData)
+            ?: throw IllegalStateException("Screen capture was not granted")
+
+        // Required on Android 14+, and tells us when the user stops the capture from the system UI
+        newProjection.registerCallback(object : MediaProjection.Callback() {
+            override fun onStop() {
+                stopStreaming()
+            }
+        }, handler)
+
+        val metrics = DisplayMetrics()
+        getSystemService<WindowManager>()!!.defaultDisplay.getRealMetrics(metrics)
+        val (width, height) = scaledSize(metrics.widthPixels, metrics.heightPixels, preset.maxSide)
+
+        val (newEncoder, newSurface) = try {
+            createEncoder(width, height, preset)
+        } catch (e: Exception) {
+            newProjection.stop()
+            throw e
+        }
+
+        val newPipe = VideoPipeInputStream(
+            onClosed = { stopStreaming() },
+            onFirstRead = { requestKeyframe() },
+        )
+
+        val newDisplay = try {
+            newProjection.createVirtualDisplay(
+                "KDEConnectScreen",
+                width,
+                height,
+                metrics.densityDpi,
+                DisplayManager.VIRTUAL_DISPLAY_FLAG_AUTO_MIRROR,
+                newSurface,
+                null,
+                null
+            )
+        } catch (e: Exception) {
+            runCatching { newEncoder.stop() }
+            newEncoder.release()
+            newSurface.release()
+            newProjection.stop()
+            throw e
+        }
+
+        synchronized(lock) {
+            projection = newProjection
+            display = newDisplay
+            encoder = newEncoder
+            inputSurface = newSurface
+            pipe = newPipe
+            running = true
+        }
+        acquireLocks()
+        if (autoStopMinutes > 0) {
+            val stopper = Runnable { stopStreaming() }
+            autoStop = stopper
+            handler.postDelayed(stopper, autoStopMinutes * 60_000L)
+        }
+
+        ScreenShareState.started(
+            device.deviceId,
+            ScreenShareState.HostActions(
+                stop = { stopStreaming() },
+                setBitrate = { bitrate -> setBitrate(bitrate) },
+                requestKeyframe = { requestKeyframe() },
+            )
+        )
+
+        val packet = NetworkPacket(ScreenSharePlugin.PACKET_TYPE_SCREENSHARE).apply {
+            this["width"] = width
+            this["height"] = height
+            this["fps"] = preset.fps
+            this["bitrate"] = preset.bitrate
+            this["codec"] = ScreenSharePlugin.CODEC_H264
+            // The size of a live stream is unknown, and the payload ends when the stream closes
+            payload = NetworkPacket.Payload(newPipe, -1L)
+        }
+        device.sendPacket(packet, object : Device.SendPacketStatusCallback() {
+            override fun onSuccess() {}
+
+            override fun onFailure(e: Throwable) {
+                Log.e(LOG_TAG, "Could not send the screen to ${device.name}", e)
+                stopStreaming()
+            }
+        })
+
+        Thread({ drainLoop(newEncoder, newPipe) }, "ScreenEncoderDrain").start()
+
+        if (withSound && Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q) startAudio(device, newProjection)
+    }
+
+    /**
+     * Sends the sound this phone plays along with the screen, as raw PCM in an audio stream packet
+     * (played by the audio streaming plugin on the other phone). Needs Android 10+. A failure
+     * here never stops the screen.
+     */
+    @RequiresApi(Build.VERSION_CODES.Q)
+    private fun startAudio(device: Device, source: MediaProjection) {
+        if (ContextCompat.checkSelfPermission(this, Manifest.permission.RECORD_AUDIO) != PackageManager.PERMISSION_GRANTED) return
+        var record: AudioRecord? = null
+        try {
+            val captureConfig = AudioPlaybackCaptureConfiguration.Builder(source)
+                .addMatchingUsage(AudioAttributes.USAGE_MEDIA)
+                .addMatchingUsage(AudioAttributes.USAGE_GAME)
+                .addMatchingUsage(AudioAttributes.USAGE_UNKNOWN)
+                .build()
+            val format = AudioFormat.Builder()
+                .setEncoding(AudioFormat.ENCODING_PCM_16BIT)
+                .setSampleRate(AUDIO_SAMPLE_RATE)
+                .setChannelMask(AudioFormat.CHANNEL_IN_STEREO)
+                .build()
+            val minBuffer = AudioRecord.getMinBufferSize(AUDIO_SAMPLE_RATE, AudioFormat.CHANNEL_IN_STEREO, AudioFormat.ENCODING_PCM_16BIT)
+            record = AudioRecord.Builder()
+                .setAudioFormat(format)
+                .setBufferSizeInBytes(maxOf(minBuffer, AUDIO_CHUNK_BYTES * 4))
+                .setAudioPlaybackCaptureConfig(captureConfig)
+                .build()
+            if (record.state != AudioRecord.STATE_INITIALIZED) throw IllegalStateException("Audio capture not initialized")
+
+            val newPipe = PcmPipeInputStream(onClosed = { stopAudio() })
+            synchronized(lock) {
+                audioRecord = record
+                audioPipe = newPipe
+                audioRunning = true
+            }
+            device.sendPacket(NetworkPacket(AudioStreamPlugin.PACKET_TYPE_AUDIOSTREAM).apply {
+                this["sampleRate"] = AUDIO_SAMPLE_RATE
+                this["channels"] = 2
+                this["encoding"] = AudioStreamPlugin.ENCODING_PCM_S16LE
+                payload = NetworkPacket.Payload(newPipe, -1L)
+            })
+            record.startRecording()
+            val activeRecord = record
+            Thread({
+                Process.setThreadPriority(Process.THREAD_PRIORITY_URGENT_AUDIO)
+                val buffer = ByteArray(AUDIO_CHUNK_BYTES)
+                while (audioRunning) {
+                    val read = activeRecord.read(buffer, 0, buffer.size)
+                    if (read < 0) break
+                    if (read > 0) newPipe.push(buffer.copyOf(read))
+                }
+            }, "ScreenAudioCapture").start()
+        } catch (e: Exception) {
+            Log.w(LOG_TAG, "Could not capture the sound, sharing the screen without it", e)
+            stopAudio()
+            runCatching { record?.release() }
+        }
+    }
+
+    private fun stopAudio() {
+        var recordToRelease: AudioRecord? = null
+        var pipeToFinish: PcmPipeInputStream? = null
+        synchronized(lock) {
+            audioRunning = false
+            recordToRelease = audioRecord
+            pipeToFinish = audioPipe
+            audioRecord = null
+            audioPipe = null
+        }
+        pipeToFinish?.finish()
+        recordToRelease?.let {
+            runCatching { it.stop() }
+            runCatching { it.release() }
+        }
+    }
+
+    /** Video sizes must be multiples of 16 for hardware encoders to accept them everywhere. */
+    private fun scaledSize(sourceWidth: Int, sourceHeight: Int, maxSide: Int): Pair<Int, Int> {
+        val scale = minOf(1f, maxSide.toFloat() / maxOf(sourceWidth, sourceHeight))
+        fun align(value: Float) = maxOf(16, (value / 16).toInt() * 16)
+        return align(sourceWidth * scale) to align(sourceHeight * scale)
+    }
+
+    /**
+     * Not every phone supports every encoder option, so try with all the low-delay options first
+     * and fall back to simpler settings.
+     */
+    private fun createEncoder(width: Int, height: Int, preset: ScreenPreset): Pair<MediaCodec, Surface> {
+        var lastError: Exception? = null
+        for (level in 2 downTo 0) {
+            var codec: MediaCodec? = null
+            try {
+                codec = MediaCodec.createEncoderByType(MediaFormat.MIMETYPE_VIDEO_AVC)
+                codec.configure(buildFormat(width, height, preset, level), null, null, MediaCodec.CONFIGURE_FLAG_ENCODE)
+                val surface = codec.createInputSurface()
+                codec.start()
+                return codec to surface
+            } catch (e: Exception) {
+                Log.w(LOG_TAG, "Encoder setup failed at level $level", e)
+                lastError = e
+                runCatching { codec?.release() }
+            }
+        }
+        throw IllegalStateException("This phone can't encode H.264 video", lastError)
+    }
+
+    private fun buildFormat(width: Int, height: Int, preset: ScreenPreset, level: Int): MediaFormat {
+        val format = MediaFormat.createVideoFormat(MediaFormat.MIMETYPE_VIDEO_AVC, width, height)
+        format.setInteger(MediaFormat.KEY_COLOR_FORMAT, MediaCodecInfo.CodecCapabilities.COLOR_FormatSurface)
+        format.setInteger(MediaFormat.KEY_BIT_RATE, preset.bitrate)
+        format.setInteger(MediaFormat.KEY_FRAME_RATE, preset.fps)
+        format.setInteger(MediaFormat.KEY_I_FRAME_INTERVAL, 1)
+        if (level >= 1) {
+            // A still screen produces no new frames, so repeat the last one to keep the stream alive
+            format.setLong(MediaFormat.KEY_REPEAT_PREVIOUS_FRAME_AFTER, 100_000L)
+        }
+        if (level >= 2) {
+            format.setInteger(MediaFormat.KEY_BITRATE_MODE, MediaCodecInfo.EncoderCapabilities.BITRATE_MODE_CBR)
+            format.setInteger(MediaFormat.KEY_PRIORITY, 0) // Real-time
+            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.R) {
+                format.setInteger(MediaFormat.KEY_LATENCY, 1)
+            }
+        }
+        return format
+    }
+
+    private fun drainLoop(codec: MediaCodec, destination: VideoPipeInputStream) {
+        Process.setThreadPriority(Process.THREAD_PRIORITY_URGENT_DISPLAY)
+        val info = MediaCodec.BufferInfo()
+        var config: ByteArray? = null
+        while (running) {
+            val index = try {
+                codec.dequeueOutputBuffer(info, 10_000)
+            } catch (e: Exception) {
+                break // The encoder was stopped
+            }
+            if (index < 0) continue // Nothing yet, or the output format changed
+
+            val buffer = codec.getOutputBuffer(index)
+            if (buffer != null && info.size > 0) {
+                buffer.position(info.offset)
+                buffer.limit(info.offset + info.size)
+                val data = ByteArray(info.size)
+                buffer.get(data)
+
+                if (info.flags and MediaCodec.BUFFER_FLAG_CODEC_CONFIG != 0) {
+                    config = data
+                    destination.push(data, VideoPipeInputStream.FLAG_CONFIG, 0L)
+                } else {
+                    val isKey = info.flags and MediaCodec.BUFFER_FLAG_KEY_FRAME != 0
+                    // Key frames carry the stream settings too, so a viewer can start at any of them
+                    val saved = config
+                    val frame = if (isKey && saved != null) saved + data else data
+                    val flags = if (isKey) VideoPipeInputStream.FLAG_KEY else 0
+                    if (destination.push(frame, flags, info.presentationTimeUs)) requestKeyframe()
+                }
+            }
+            runCatching { codec.releaseOutputBuffer(index, false) }
+        }
+        if (running) stopStreaming() // Ended by itself, not because we were asked to stop
+    }
+
+    private fun requestKeyframe() {
+        runCatching {
+            encoder?.setParameters(Bundle().apply { putInt(MediaCodec.PARAMETER_KEY_REQUEST_SYNC_FRAME, 0) })
+        }
+    }
+
+    private fun setBitrate(bitrate: Int) {
+        if (bitrate <= 0) return
+        runCatching {
+            encoder?.setParameters(Bundle().apply { putInt(MediaCodec.PARAMETER_KEY_VIDEO_BITRATE, bitrate) })
+        }
+    }
+
+    @Suppress("DEPRECATION") // WIFI_MODE_FULL_HIGH_PERF is the one that works on every Android version
+    private fun acquireLocks() {
+        wakeLock = getSystemService<PowerManager>()
+            ?.newWakeLock(PowerManager.PARTIAL_WAKE_LOCK, "kdeconnect:screenshare")
+            ?.apply {
+                setReferenceCounted(false)
+                acquire()
+            }
+        wifiLock = applicationContext.getSystemService<WifiManager>()
+            ?.createWifiLock(WifiManager.WIFI_MODE_FULL_HIGH_PERF, "kdeconnect:screenshare")
+            ?.apply {
+                setReferenceCounted(false)
+                acquire()
+            }
+    }
+
+    private fun releaseLocks() {
+        runCatching { wakeLock?.takeIf { it.isHeld }?.release() }
+        runCatching { wifiLock?.takeIf { it.isHeld }?.release() }
+        wakeLock = null
+        wifiLock = null
+    }
+
+    private fun stopStreaming(stopService: Boolean = true) {
+        var displayToRelease: VirtualDisplay? = null
+        var encoderToRelease: MediaCodec? = null
+        var surfaceToRelease: Surface? = null
+        var projectionToStop: MediaProjection? = null
+        var pipeToFinish: VideoPipeInputStream? = null
+        synchronized(lock) {
+            running = false
+            displayToRelease = display
+            encoderToRelease = encoder
+            surfaceToRelease = inputSurface
+            projectionToStop = projection
+            pipeToFinish = pipe
+            display = null
+            encoder = null
+            inputSurface = null
+            projection = null
+            pipe = null
+        }
+        ScreenShareState.ended()
+
+        stopAudio()
+        autoStop?.let { handler.removeCallbacks(it) }
+        autoStop = null
+        pipeToFinish?.finish()
+        displayToRelease?.let { runCatching { it.release() } }
+        encoderToRelease?.let {
+            runCatching { it.stop() }
+            runCatching { it.release() }
+        }
+        surfaceToRelease?.let { runCatching { it.release() } }
+        projectionToStop?.let { runCatching { it.stop() } }
+        releaseLocks()
+
+        if (stopService) {
+            ServiceCompat.stopForeground(this, ServiceCompat.STOP_FOREGROUND_REMOVE)
+            stopSelf()
+        }
+    }
+
+    private fun buildNotification(deviceName: String): Notification {
+        val stopIntent = PendingIntent.getService(
+            this,
+            0,
+            Intent(this, ScreenCaptureService::class.java).setAction(ACTION_STOP),
+            PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE
+        )
+        return NotificationCompat.Builder(this, NotificationHelper.Channels.MEDIA_CONTROL)
+            .setSmallIcon(R.drawable.ic_notification)
+            .setContentTitle(getString(R.string.screenshare_notification_title, deviceName))
+            .setOngoing(true)
+            .setOnlyAlertOnce(true)
+            .addAction(R.drawable.ic_stop, getString(R.string.screenshare_notification_stop), stopIntent)
+            .build()
+    }
+
+    companion object {
+        const val EXTRA_DEVICE_ID = "deviceId"
+        const val EXTRA_RESULT_CODE = "resultCode"
+        const val EXTRA_RESULT_DATA = "resultData"
+        const val EXTRA_PRESET = "preset"
+        const val EXTRA_AUTO_STOP_MINUTES = "autoStopMinutes"
+        const val EXTRA_SOUND = "sound"
+        const val ACTION_STOP = "org.kde.kdeconnect.plugins.screenshare.STOP"
+
+        private const val LOG_TAG = "ScreenCaptureService"
+        private const val NOTIFICATION_ID = 0x53435231
+
+        private const val AUDIO_SAMPLE_RATE = 48000
+
+        // 20 ms of stereo 16-bit audio per chunk
+        private const val AUDIO_CHUNK_BYTES = AUDIO_SAMPLE_RATE / 50 * 4
+    }
+}
