index 00000000..cb30c081
--- /dev/null
+++ b/src/main/java/org/kde/kdeconnect/plugins/screenshare/VideoPipeInputStream.kt
@@ -0,0 +1,134 @@
+/*
+ * SPDX-FileCopyrightText: 2026 KDE Connect contributors
+ *
+ * SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+package org.kde.kdeconnect.plugins.screenshare
+
+import java.io.InputStream
+import java.nio.ByteBuffer
+import java.util.concurrent.LinkedBlockingQueue
+import java.util.concurrent.atomic.AtomicBoolean
+
+/**
+ * An [InputStream] fed by the video encoder and drained by the payload sender.
+ *
+ * Every video frame is written as: 4 bytes length, 1 byte flags, 8 bytes timestamp (microseconds),
+ * then the frame data. All numbers are big endian.
+ *
+ * The queue is short on purpose: when the network is slower than the video, the waiting frames are
+ * thrown away and the stream resumes at the next key frame, so the picture never falls further
+ * and further behind the screen. That is what keeps the delay low.
+ */
+internal class VideoPipeInputStream(
+    private val onClosed: () -> Unit,
+    private val onFirstRead: () -> Unit,
+) : InputStream() {
+
+    private val queue = LinkedBlockingQueue<ByteArray>(MAX_QUEUED_FRAMES)
+    private val finished = AtomicBoolean(false)
+
+    @Volatile
+    private var waitingForKey = false
+
+    // Only touched by the single consumer thread
+    private var current: ByteArray = EMPTY
+    private var position = 0
+    private var reachedEnd = false
+    private var firstRead = true
+
+    /**
+     * Called by the encoder thread. Never blocks.
+     * @return true when frames were dropped and the encoder should produce a new key frame.
+     */
+    fun push(data: ByteArray, flags: Int, presentationTimeUs: Long): Boolean {
+        if (finished.get()) return false
+        val isKey = flags and FLAG_KEY != 0 || flags and FLAG_CONFIG != 0
+        if (waitingForKey && !isKey) return false
+
+        val framed = ByteBuffer.allocate(HEADER_BYTES + data.size)
+            .putInt(data.size)
+            .put(flags.toByte())
+            .putLong(presentationTimeUs)
+            .put(data)
+            .array()
+
+        if (queue.offer(framed)) {
+            if (isKey) waitingForKey = false
+            return false
+        }
+
+        // The network can't keep up: start over from a fresh key frame
+        queue.clear()
+        if (isKey) {
+            queue.offer(framed)
+            waitingForKey = false
+            return false
+        }
+        waitingForKey = true
+        return true
+    }
+
+    /** Ends the stream. The consumer sees end-of-stream as soon as it asks for more data. */
+    fun finish() {
+        if (finished.compareAndSet(false, true)) {
+            queue.clear()
+            queue.offer(END_OF_STREAM)
+        }
+    }
+
+    override fun read(): Int {
+        val single = ByteArray(1)
+        return if (read(single, 0, 1) < 0) -1 else single[0].toInt() and 0xFF
+    }
+
+    override fun read(buffer: ByteArray, offset: Int, length: Int): Int {
+        if (length == 0) return 0
+        if (reachedEnd) return -1
+
+        if (firstRead) {
+            // The other phone has just connected. Anything captured before is stale: skip it and
+            // ask the encoder for a fresh key frame so the picture appears immediately.
+            firstRead = false
+            queue.clear()
+            waitingForKey = true
+            onFirstRead()
+        }
+
+        if (position >= current.size) {
+            val next = try {
+                queue.take()
+            } catch (e: InterruptedException) {
+                Thread.currentThread().interrupt()
+                reachedEnd = true
+                return -1
+            }
+            if (next === END_OF_STREAM) {
+                reachedEnd = true
+                return -1
+            }
+            current = next
+            position = 0
+        }
+
+        val count = minOf(length, current.size - position)
+        System.arraycopy(current, position, buffer, offset, count)
+        position += count
+        return count
+    }
+
+    override fun close() {
+        finish()
+        onClosed()
+    }
+
+    companion object {
+        const val FLAG_KEY = 1
+        const val FLAG_CONFIG = 2
+        const val HEADER_BYTES = 13
+
+        private const val MAX_QUEUED_FRAMES = 8
+        private val EMPTY = ByteArray(0)
+        private val END_OF_STREAM = ByteArray(0)
+    }
+}
